<!DOCTYPE html>
<html lang="en">
<%
    const isShortlistView = typeof isShortlist !== 'undefined' && Boolean(isShortlist);
    const savedShortlistIds = typeof shortlistIds !== 'undefined' && Array.isArray(shortlistIds) ? shortlistIds : [];
%>
<%- include('partials/head-public', { pageTitle: isShortlistView ? 'Your Shortlist | The Auto Choice' : 'Inventory | The Auto Choice' }) %>
<body>
<%- include('partials/navbar', { isAdmin: typeof isAdmin !== 'undefined' && isAdmin }) %>

<main class="inventory-page">
<div class="container">
    <header class="page-heading">
        <p class="section-eyebrow"><%= isShortlistView ? 'YOUR SHORTLIST' : 'THE AUTOVAULT COLLECTION' %></p>
        <h1><%= isShortlistView ? 'Your saved cars' : 'Find your next car' %></h1>
        <p><%= isShortlistView ? 'Your cars, shown in the order you saved them.' : 'Every listing is inspected, verified, and ready for its next chapter.' %></p>
    </header>
</div>
<div class="container inventory-layout" id="inventory-section">

    <!-- ═══════════════ SIDEBAR FILTERS ═══════════════ -->
    <aside class="sidebar-filters" id="sidebar-filters">
        <div class="filter-header">
            <h3>Filters</h3>
            <a href="/inventory" class="btn-text" id="reset-filters-btn">Reset All</a>
        </div>

        <form id="filter-form" action="/inventory" method="GET">
            <!-- Search -->
            <div class="filter-group">
                <label for="filter-search">Search Keyword</label>
                <input
                    type="text"
                    id="filter-search"
                    name="search"
                    placeholder="Search by name, model..."
                    value="<%= typeof query !== 'undefined' && query.search ? query.search : '' %>"
                >
            </div>

            <!-- Make -->
            <div class="filter-group">
                <label for="filter-make">Brand / Make</label>
                <select id="filter-make" name="make">
                    <option value="">All Brands</option>
                    <% ['Mahindra', 'Tata', 'Maruti Suzuki', 'Hyundai', 'Honda', 'Toyota', 'Kia', 'MG'].forEach(brand => { %>
                        <option value="<%= brand %>"
                            <%= (typeof query !== 'undefined' && query.make === brand) ? 'selected' : '' %>>
                            <%= brand %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <!-- Body Style -->
            <div class="filter-group">
                <label for="filter-body">Body Style</label>
                <select id="filter-body" name="bodyType">
                    <option value="">All Body Styles</option>
                    <% ['SUV', 'Hatchback', 'Sedan', 'EV', 'MUV', 'Coupe', 'Convertible'].forEach(type => { %>
                        <option value="<%= type %>"
                            <%= (typeof query !== 'undefined' && query.bodyType === type) ? 'selected' : '' %>>
                            <%= type === 'EV' ? 'Electric (EV)' : type %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <!-- Fuel Type -->
            <div class="filter-group">
                <label for="filter-fuel">Fuel Type</label>
                <select id="filter-fuel" name="fuelType">
                    <option value="">All Fuel Types</option>
                    <% ['Petrol', 'Diesel', 'CNG', 'Electric', 'Hybrid'].forEach(fuel => { %>
                        <option value="<%= fuel %>"
                            <%= (typeof query !== 'undefined' && query.fuelType === fuel) ? 'selected' : '' %>>
                            <%= fuel %>
                        </option>
                    <% }) %>
                </select>
            </div>

            <!-- Transmission -->
            <div class="filter-group">
                <label for="filter-transmission">Transmission</label>
                <select id="filter-transmission" name="transmission">
                    <option value="">All</option>
                    <option value="Manual"    <%= (typeof query !== 'undefined' && query.transmission === 'Manual')    ? 'selected' : '' %>>Manual</option>
                    <option value="Automatic" <%= (typeof query !== 'undefined' && query.transmission === 'Automatic') ? 'selected' : '' %>>Automatic</option>
                </select>
            </div>

            <!-- Max Price Slider -->
            <div class="filter-group">
                <label for="filter-price">
                    Max Budget: <span id="price-val">
                        <%
                            const maxPriceVal = (typeof query !== 'undefined' && query.maxPrice)
                                ? Number(query.maxPrice)
                                : 3500000;
                        %>
                        ₹<%= maxPriceVal.toLocaleString('en-IN') %>
                    </span>
                </label>
                <input
                    type="range"
                    id="filter-price"
                    name="maxPrice"
                    min="500000"
                    max="3500000"
                    step="50000"
                    value="<%= maxPriceVal %>"
                    oninput="updatePriceLabel(this.value)"
                >
            </div>

            <% if (isShortlistView) { %>
                <input type="hidden" name="shortlist" id="shortlist-filter" value="<%= savedShortlistIds.join(',') %>">
            <% } else { %>
                <!-- Sort (hidden — controlled by sort-select above) -->
                <input type="hidden" name="sort" id="hidden-sort" value="<%= (typeof query !== 'undefined' && query.sort) ? query.sort : 'newest' %>">
            <% } %>

            <button type="submit" class="btn-primary w-100" id="apply-filters-btn">Apply Filters</button>
        </form>
    </aside>

    <!-- ═══════════════ INVENTORY MAIN ═══════════════ -->
    <section class="inventory-main" aria-label="Available cars">
        <!-- Sort Bar -->
        <div class="sort-bar">
                <p class="results-count"><span id="result-count"><%= cars.length %></span> <%= isShortlistView ? 'cars in your shortlist' : 'cars available' %></p>
            <div class="sort-actions">
                <% if (isShortlistView) { %>
                    <span>Sorted by save order</span>
                <% } else { %>
                    <label for="sort-select">Sort by:</label>
                    <select id="sort-select" onchange="applySort(this.value)">
                        <option value="newest"    <%= (typeof query !== 'undefined' && query.sort === 'newest')    ? 'selected' : '' %>>Newest First</option>
                        <option value="price-asc" <%= (typeof query !== 'undefined' && query.sort === 'price-asc') ? 'selected' : '' %>>Price: Low to High</option>
                        <option value="price-desc" <%= (typeof query !== 'undefined' && query.sort === 'price-desc') ? 'selected' : '' %>>Price: High to Low</option>
                        <option value="km-asc"   <%= (typeof query !== 'undefined' && query.sort === 'km-asc')    ? 'selected' : '' %>>Kilometers: Lowest</option>
                        <option value="year-desc" <%= (typeof query !== 'undefined' && query.sort === 'year-desc') ? 'selected' : '' %>>Year: Newest</option>
                    </select>
                <% } %>
            </div>
        </div>

        <!-- Car Grid -->
        <% if (cars && cars.length > 0) { %>
            <div class="car-grid" id="inventory-grid">
                <% cars.forEach(car => { %>
                    <%
                        const imgSrc = (car.images && car.images.length > 0)
                            ? car.images[0].url
                            : 'https://images.unsplash.com/photo-1503376780353-7e6692767b70?w=800&q=80';
                    %>
                    <article class="car-card" id="car-card-<%= car._id %>">
                        <a href="/inventory/<%= car.slug || car._id %>" class="card-link">
                            <div class="car-img-wrapper">
                                <img src="<%= imgSrc %>" alt="<%= car.year %> <%= car.make %> <%= car.model %>" loading="lazy">
                                <div class="cpo-tag">
                                    <svg class="badge-icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <polyline points="20 6 9 17 4 12"></polyline>
                                    </svg>
                                    <span>The Auto Choice Certified</span>
                                </div>
                                <% if (car.fuelType === 'Electric') { %>
                                    <div class="ev-badge">
                                        <svg class="ev-bolt-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                                        </svg>
                                        <span>EV</span>
                                    </div>
                                <% } %>
                            </div>
                            <div class="car-details">
                                <div class="car-title"><%= car.year %> <%= car.make %> <%= car.model %></div>
                                <div class="car-specs">
                                    <%= car.mileage.toLocaleString('en-IN') %> km &nbsp;|&nbsp;
                                    <%= car.fuelType %> &nbsp;|&nbsp;
                                    <%= car.transmission %>
                                </div>
                                <% if (car.variant) { %><div class="car-variant"><%= car.variant %></div><% } %>
                                <% if (car.rtoLocation) { %>
                                    <div class="car-location"><%= car.rtoLocation %><% if (car.ownership) { %> · <%= car.ownership %><% } %></div>
                                <% } %>
                                <div class="car-price"><%= formatPrice(car.price) %></div>
                            </div>
                        </a>
                        <div class="card-actions">
                            <a href="/inventory/<%= car.slug || car._id %>" class="btn-details" id="details-btn-<%= car._id %>">View Details</a>
                            <button
                                class="btn-save"
                                id="save-btn-<%= car._id %>"
                                data-car-id="<%= car._id %>"
                                onclick="toggleShortlist('<%= car._id %>', this)"
                                aria-label="Save to shortlist"
                            >
                                <svg class="save-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                                </svg>
                                <span class="save-text">Save</span>
                            </button>
                        </div>
                    </article>
                <% }) %>
            </div>
            <% if (typeof totalPages !== 'undefined' && totalPages > 1 && !isShortlistView) { %>
                <div class="pagination-bar" id="inventory-pagination">
                    <%
                        const buildPageUrl = (p) => {
                            const params = new URLSearchParams(query || {});
                            params.set('page', p);
                            return '/inventory?' + params.toString();
                        };
                    %>
                    <% if (currentPage > 1) { %>
                        <a href="<%= buildPageUrl(currentPage - 1) %>" class="btn-outline page-nav-btn">← Prev</a>
                    <% } %>
                    <div class="page-numbers">
                        <% for (let p = 1; p <= totalPages; p++) { %>
                            <% if (p === currentPage) { %>
                                <span class="page-num active"><%= p %></span>
                            <% } else if (p === 1 || p === totalPages || (p >= currentPage - 2 && p <= currentPage + 2)) { %>
                                <a href="<%= buildPageUrl(p) %>" class="page-num"><%= p %></a>
                            <% } else if (p === currentPage - 3 || p === currentPage + 3) { %>
                                <span class="page-dots">…</span>
                            <% } %>
                        <% } %>
                    </div>
                    <% if (currentPage < totalPages) { %>
                        <a href="<%= buildPageUrl(currentPage + 1) %>" class="btn-outline page-nav-btn">Next →</a>
                    <% } %>
                </div>
            <% } %>
        <% } else { %>
            <div class="empty-state" id="empty-inventory">
                <% if (isShortlistView && savedShortlistIds.length === 0) { %>
                    <h3>Your shortlist is empty</h3>
                    <p>Save cars while exploring, and they’ll appear here in the order you added them.</p>
                    <a href="/inventory" class="btn-primary" id="clear-filters-btn">Explore Cars</a>
                <% } else if (isShortlistView) { %>
                    <h3>No saved cars are available</h3>
                    <p>Some cars in your shortlist may no longer be listed.</p>
                    <a href="/inventory" class="btn-primary" id="clear-filters-btn">Explore Cars</a>
                <% } else { %>
                    <h3>No cars match your filters</h3>
                    <p>Try widening your budget, removing brand criteria, or resetting all filters.</p>
                    <a href="/inventory" class="btn-primary" id="clear-filters-btn">Clear Filters</a>
                <% } %>
            </div>
        <% } %>
    </section>

</div>
</main>

<%- include('partials/footer') %>
