<%# ── Main Header ── %>
<header class="rw-hdr" id="rw-hdr">
  <div class="rw-hdr__in">

    <%# Brand %>
    <a href="/" class="rw-brand" aria-label="The Auto Choice — home">
      <div class="rw-brand__mark" aria-hidden="true">TAC</div>
      <div>
        <span style="display:block; color:inherit;">The Auto Choice</span>
        <span class="rw-brand__sub">Used cars · Jabalpur</span>
      </div>
    </a>

    <%# Desktop Search %>
    <form action="/inventory" method="GET" class="rw-hdr__search rw-desktop-only" role="search" style="flex:1;max-width:400px;">
      <div class="rw-hero__search" style="margin:0;">
        <svg aria-hidden="true" focusable="false"><use href="#ni-search"/></svg>
        <input type="search" name="search" placeholder="Search Mahindra, Tata, Swift…" autocomplete="off" aria-label="Search cars">
        <button type="submit" aria-label="Submit search">→</button>
      </div>
    </form>

    <%# Desktop Nav %>
    <nav class="rw-nav rw-desktop-only" aria-label="Main">
      <a href="/inventory">Cars for sale</a>
      <a href="/inventory?bodyType=SUV">SUVs</a>
      <a href="/inventory?bodyType=Hatchback">Hatchbacks</a>
    </nav>

    <%# Desktop Actions %>
    <div class="rw-hdr__act">
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <a href="/admin" class="rw-btn rw-btn--ghost rw-btn--sm rw-desktop-only">
          <svg aria-hidden="true" focusable="false"><use href="#ni-gear"/></svg>
          Dashboard
        </a>
      <% } else { %>
        <button
          class="rw-btn rw-btn--ghost rw-btn--sm rw-desktop-only"
          onclick="openShortlist(event)"
          aria-label="Your shortlist"
          style="gap:6px;"
        >
          <svg aria-hidden="true" focusable="false"><use href="#ni-heart"/></svg>
          <span>Shortlist</span>
          <span class="modern-badge" id="shortlist-count" style="background:var(--lime);color:#0c0e0d;border-radius:100px;padding:1px 6px;font-size:0.65rem;font-weight:900;min-width:18px;text-align:center;display:none;">0</span>
        </button>
        <a href="https://wa.me/919516486666?text=Hi%20The%20Auto%20Choice%2C%20I%20found%20you%20on%20your%20website%20and%20I'd%20like%20to%20know%20more%20about%20your%20cars."
           class="rw-btn rw-btn--wa rw-btn--sm" target="_blank" rel="noopener">
          <svg aria-hidden="true" focusable="false"><use href="#ni-wa"/></svg>
          <span class="rw-hdr__wa-text">WhatsApp</span>
        </a>
        <a href="tel:+919516486666" class="rw-btn rw-btn--ghost rw-btn--sm rw-desktop-only">
          <svg aria-hidden="true" focusable="false"><use href="#ni-phone"/></svg>
          Call
        </a>
      <% } %>

      <%# Hamburger %>
      <button class="rw-burger" id="rw-burger" aria-expanded="false" aria-controls="rw-menu" aria-label="Menu">
        <svg aria-hidden="true" focusable="false"><use href="#ni-menu"/></svg>
      </button>
    </div>
  </div>
</header>

<%# ── Mobile Menu Drawer ── %>
<div class="rw-menu" id="rw-menu" aria-hidden="true">
  <form action="/inventory" method="GET" role="search" style="padding:8px 0 4px;">
    <div class="rw-hero__search" style="margin:0;max-width:100%;">
      <svg aria-hidden="true" focusable="false"><use href="#ni-search"/></svg>
      <input type="search" name="search" placeholder="Search cars…" autocomplete="off">
      <button type="submit">→</button>
    </div>
  </form>
  <a href="/inventory">
    <svg aria-hidden="true" focusable="false"><use href="#ni-arrow"/></svg>
    Cars for sale
  </a>
  <a href="/inventory?bodyType=SUV">
    <svg aria-hidden="true" focusable="false"><use href="#ni-arrow"/></svg>
    SUVs
  </a>
  <a href="/inventory?bodyType=Hatchback">
    <svg aria-hidden="true" focusable="false"><use href="#ni-arrow"/></svg>
    Hatchbacks
  </a>
  <a href="/inventory?bodyType=Sedan">
    <svg aria-hidden="true" focusable="false"><use href="#ni-arrow"/></svg>
    Sedans
  </a>
  <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
    <a href="/admin">
      <svg aria-hidden="true" focusable="false"><use href="#ni-gear"/></svg>
      Admin Dashboard
    </a>
  <% } else { %>
    <a href="javascript:void(0)" onclick="openShortlist(event)">
      <svg aria-hidden="true" focusable="false"><use href="#ni-heart"/></svg>
      Shortlist
      <span class="modern-badge" id="mobile-shortlist-count" style="background:var(--lime);color:#0c0e0d;border-radius:100px;padding:1px 6px;font-size:0.65rem;font-weight:900;display:none;">0</span>
    </a>
  <% } %>
  <div class="rw-menu__btns">
    <a href="https://wa.me/919516486666?text=Hi%20The%20Auto%20Choice%2C%20I%20found%20you%20on%20your%20website%20and%20I'd%20like%20to%20know%20more%20about%20your%20cars."
       class="rw-btn rw-btn--wa" target="_blank" rel="noopener">
      <svg aria-hidden="true" focusable="false"><use href="#ni-wa"/></svg>
      WhatsApp
    </a>
    <a href="tel:+919516486666" class="rw-btn rw-btn--ghost">
      <svg aria-hidden="true" focusable="false"><use href="#ni-phone"/></svg>
      Call us
    </a>
  </div>
</div>

<script>
  // Burger toggle
  (function () {
    var burger = document.getElementById('rw-burger');
    var menu   = document.getElementById('rw-menu');
    if (!burger || !menu) return;
    burger.addEventListener('click', function () {
      var open = menu.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(open));
      menu.setAttribute('aria-hidden', String(!open));
    });
  })();

  // Shortlist count badge
  (function syncBadge() {
    var el = document.getElementById('shortlist-count');
    var mel = document.getElementById('mobile-shortlist-count');
    function update() {
      try {
        var sl = JSON.parse(localStorage.getItem('shortlist') || '[]');
        var n = Array.isArray(sl) ? sl.length : 0;
        [el, mel].forEach(function(e) {
          if (!e) return;
          e.textContent = n;
          e.style.display = n > 0 ? 'inline-block' : 'none';
        });
      } catch(e) {}
    }
    update();
    window.addEventListener('storage', update);
    document.addEventListener('shortlistChanged', update);
  })();
</script>