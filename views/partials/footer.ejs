<!-- ═══════════════════════════════════════════
     FOOTER — redesigned dark editorial style
══════════════════════════════════════════════ -->
<footer class="rw-footer">
  <div class="rw-wrap">
    <div class="rw-footer__grid">

      <!-- Brand / Showroom info -->
      <div>
        <a href="/" class="rw-footer__brand" aria-label="The Auto Choice home">
          <img class="rw-footer__circle" src="/pictures/circle_logo.png" alt="" aria-hidden="true" width="46"
            height="46">
          <img class="rw-footer__logo" src="/pictures/logo.png" alt="The Auto Choice">
        </a>
        <p class="rw-footer__addr">
          Plot no. 43, Infront of Flyover Over Pillar no. 123,<br>
          Madan Mahal Station Road, Ranital Chowk,<br>
          Jabalpur, M.P. 482001
        </p>
        <a href="https://www.google.com/maps/dir/?api=1&destination=23.1661222%2C79.922788" class="rw-footer__dir"
          target="_blank" rel="noopener noreferrer">
          Get directions
          <svg aria-hidden="true" focusable="false">
            <use href="#ni-arrow-ne" />
          </svg>
        </a>

        <!-- Social links -->
        <div style="display:flex;gap:10px;margin-top:20px;">
          <a href="https://wa.me/919516486666" class="rw-btn rw-btn--wa rw-btn--sm" target="_blank" rel="noopener"
            aria-label="WhatsApp us">
            <svg aria-hidden="true" focusable="false">
              <use href="#ni-wa" />
            </svg>
            WhatsApp
          </a>
          <%- include('call-picker', { variant: 'is-footer' , callLabel: 'Call' }) %>
        </div>
      </div>

      <!-- Cars links -->
      <div class="rw-footer__col">
        <h4>Cars</h4>
        <ul class="rw-footer__list">
          <li><a href="/inventory?bodyType=SUV">SUVs</a></li>
          <li><a href="/inventory?bodyType=Hatchback">Hatchbacks</a></li>
          <li><a href="/inventory?bodyType=Sedan">Sedans</a></li>
          <li><a href="/inventory?bodyType=MUV">MUVs</a></li>
          <li><a href="/inventory?minSeats=7">7+ seats</a></li>
          <li><a href="/inventory?maxPrice=500000">Under ₹5 Lakh</a></li>
        </ul>
      </div>


      <!-- Contact -->
      <div class="rw-footer__col">
        <h4>Talk to us</h4>
        <ul class="rw-footer__list">
          <li>
            <a href="tel:+919516486666">+91 95164 86666</a>
          </li>
          <li>
            <a href="tel:+918602228333">+91 86022 28333</a>
          </li>
          <li>
            <a href="tel:+919425466138">+91 94254 66138</a>
          </li>
          <li>
            <a href="tel:+917614036666">0761 - 4036666</a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="rw-footer__bottom">
      <p class="rw-footer__copy">
        &copy; <%= new Date().getFullYear() %> The Auto Choice Pvt. Ltd. All rights reserved.
      </p>
      <div class="rw-footer__links">
        <a href="/admin" aria-label="Admin portal" title="Admin portal" style="color:var(--ink-faint);">
          <svg style="width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;"
            viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6z" />
            <path
              d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
          </svg>
        </a>
        <!-- Theme toggle -->
        <button id="themeToggleFooter" class="rw-btn rw-btn--sm" type="button" aria-label="Toggle theme"
          style="border:none;padding:0.4rem 0.6rem;min-height:auto;color:var(--ink-faint);background:transparent;">
          <svg id="footerIconMoon" style="width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;"
            viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <svg id="footerIconSun"
            style="width:16px;height:16px;stroke:currentColor;fill:none;stroke-width:2;display:none;"
            viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</footer>

<!-- Toast notification (used by shortlist JS) -->
<div class="rw-toast" id="toast"></div>



<script src="/js/main.js"></script>
</body>

</html>