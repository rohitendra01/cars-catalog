<footer class="rw-footer">
  <div class="rw-wrap">
    <div class="rw-footer__grid">

      <!-- Brand / Showroom info -->
      <div>
        <a href="/" class="rw-footer__brand" aria-label="The Auto Choice home">
          <div class="rw-footer__mark" aria-hidden="true">TAC</div>
          The Auto Choice
