        <p class="rw-footer__addr">
          Plot No. 43, Near Chirayu Hospital,<br>
          Ranital Chowk – Madan Mahal Station Road,<br>
          Wright Town, Jabalpur 482002<br>
          Madhya Pradesh
        </p>
        <a href="https://www.google.com/maps/dir/?api=1&destination=23.1661222%2C79.922788" class="rw-footer__dir"
          target="_blank" rel="noopener noreferrer">
          Get directions
          <svg aria-hidden="true" focusable="false">
            <use href="#ni-arrow-ne" />
          </svg>
        </a>

        <!-- Social links -->
        <div style="display:flex;gap:10px;margin-top:20px;">
          <a href="https://wa.me/919516486666" class="rw-btn rw-btn--wa rw-btn--sm" target="_blank" rel="noopener"
            aria-label="WhatsApp us">
            <svg aria-hidden="true" focusable="false">
              <use href="#ni-wa" />
            </svg>
            WhatsApp
          </a>
          <a href="tel:+919516486666" class="rw-btn rw-btn--ghost rw-btn--sm" aria-label="Call us">
            <svg aria-hidden="true" focusable="false">
              <use href="#ni-phone" />
            </svg>
            Call
          </a>
        </div>
      </div>

      <!-- Cars links -->
      <div class="rw-footer__col">
        <h4>Cars</h4>
        <ul class="rw-footer__list">
          <li><a href="/inventory?bodyType=SUV">SUVs</a></li>
          <li><a href="/inventory?bodyType=Hatchback">Hatchbacks</a></li>
          <li><a href="/inventory?bodyType=Sedan">Sedans</a></li>
          <li><a href="/inventory?bodyType=MUV">MUVs</a></li>
          <li><a href="/inventory?seats=7">7+ seats</a></li>
          <li><a href="/inventory?maxPrice=500000">Under ₹5 Lakh</a></li>
        </ul>
      </div>

      <!-- The Auto Choice links -->
      <div class="rw-footer__col">
        <h4>The Auto Choice</h4>
        <ul class="rw-footer__list">
          <li><a href="/inventory">All cars for sale</a></li>
          <li><a href="/sell-your-car">Sell or exchange</a></li>
          <li><a href="/finance">Finance</a></li>
          <li><a href="/about">The showroom</a></li>
          <li><a href="/visit">Visit us</a></li>
          <li><a href="/test-drive">Book a test drive</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div class="rw-footer__col">
        <h4>Talk to us</h4>
        <ul class="rw-footer__list">
          <li>
            <a href="tel:+919516486666">+91 95164 86666</a>
          </li>
          <li>
            <a href="tel:+918602228333">+91 86022 28333</a>
          </li>
          <li>
            <a href="mailto:autochoicecar@gmail.com">autochoicecar@gmail.com</a>
          </li>
