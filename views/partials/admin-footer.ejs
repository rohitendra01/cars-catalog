    <div class="flex items-center justify-between w-full max-w-[1920px] mx-auto">
        <p class="font-mono text-[10px] text-zinc-400 uppercase tracking-widest">
            &copy; <%= new Date().getFullYear() %> AutoVault India. All rights reserved.
        </p>
        <div class="flex items-center gap-4">
            <span class="font-mono text-[10px] text-zinc-300 dark:text-zinc-600 hidden sm:block">Admin Panel v1.0</span>
            <a href="/" title="Go to live site" class="text-zinc-400 hover:text-brand transition-colors"
                aria-label="Live site">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
