<%#
  views/layouts/main.ejs
  Public site layout — reference / documentation file.

  All public views (index, inventory, car-detail, 404) implement this
  structure directly using EJS includes since express-ejs-layouts is not
  installed. To upgrade to a layout-slot system, install:
    npm install express-ejs-layouts
  and update server.js with:
    const ejsLayouts = require('express-ejs-layouts');
    app.use(ejsLayouts);
    app.set('layout', 'layouts/main');

  STRUCTURE EACH PUBLIC VIEW FOLLOWS:
  ─────────────────────────────────────────────────────
  <!DOCTYPE html>
  <html lang="en">
  <%- include('partials/head-public', { pageTitle: '...' }) %>
  <body>
  <%- include('partials/navbar', { isAdmin: typeof isAdmin !== 'undefined' && isAdmin }) %>

  <main> ... page content ... </main>

  <%- include('partials/footer') %>
  </body>
  </html>
  ─────────────────────────────────────────────────────
%>
<!DOCTYPE html>
<html lang="en">
<%- include('../partials/head-public', locals) %>
<body>
  <%- include('../partials/navbar', { isAdmin: typeof isAdmin !== 'undefined' && isAdmin }) %>
<%- body %>
<%- include('../partials/footer') %>
</body>
</html>
