<!DOCTYPE html>
<html lang="en">
<%- include('partials/head-public', { pageTitle: '404 Not Found | AutoVault India' }) %>
<body>
<%- include('partials/navbar', { isAdmin: typeof isAdmin !== 'undefined' && isAdmin }) %>
<main>
<section class="container not-found-page">
    <p class="section-eyebrow">NOT ON THIS ROUTE</p>
    <h1>404</h1>
    <h2>Page not found</h2>
    <p>
        <%= typeof message !== 'undefined' ? message : "The page you're looking for doesn't exist." %>
    </p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;align-items:center;">
        <a href="/" class="btn-primary" id="go-home-btn">
            <span>Return home</span>
            <svg class="btn-arrow-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
        </a>
        <a href="/inventory" class="btn-outline" id="go-inventory-btn">
            <span>Explore Cars</span>
        </a>
    </div>
</section>
</main>
<%- include('partials/footer') %>
