<%- include('../partials/head-admin', { pageTitle: 'Add New Car | The Auto Choice Admin' }) %>

<%- include('../partials/admin-topbar', { showAddBtn: false }) %>

<main class="admin-main admin-add-page flex-1 pt-16 pb-16 max-w-[1920px] mx-auto w-full">
<div class="admin-content px-4 sm:px-6 lg:px-10 py-8">

    <!-- Page Heading -->
    <div class="mb-8">
        <a href="/admin" class="font-mono text-[10px] text-zinc-400 uppercase tracking-widest hover:text-brand transition-colors flex items-center gap-1 mb-4">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
            Back to Dashboard
        </a>
        <p class="section-eyebrow">AUTOVAULT / INVENTORY</p>
        <h1 class="font-display font-black text-3xl sm:text-4xl text-zinc-950 dark:text-white uppercase tracking-tighter mb-1">
            Add New Car
        </h1>
        <p class="admin-page-intro text-zinc-400 font-mono text-[11px] uppercase tracking-widest">
            Add the vehicle details and listing images.
        </p>
    </div>

    <!-- Flash Messages -->
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 px-4 py-3 bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 text-red-700 dark:text-red-400 font-mono text-xs uppercase tracking-widest flex items-center gap-2" role="alert">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <%= error %>
        </div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="mb-6 px-4 py-3 bg-green-50 dark:bg-green-900/20 border border-green-200 dark:border-green-800 text-green-700 dark:text-green-400 font-mono text-xs uppercase tracking-widest flex items-center gap-2" role="alert">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
            <%= success %>
        </div>
    <% } %>

    <!-- Form Card -->
    <div class="admin-form-surface bg-white dark:bg-[#0a0a0a] border border-zinc-200 dark:border-zinc-800 max-w-3xl">
        <form action="/admin/add" method="POST" enctype="multipart/form-data" id="add-car-form" class="px-6 py-6 space-y-0" novalidate>

            <!-- ── Section: Vehicle Identity ────────────────────────── -->
            <div class="mb-6">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-1 h-5 bg-brand"></div>
                    <h3 class="font-mono font-bold text-[11px] text-zinc-500 uppercase tracking-widest">Vehicle Identity</h3>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div class="col-span-2 sm:col-span-1">
                        <label for="make" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">Brand / Make <span class="text-brand">*</span></label>
                        <input type="text" id="make" name="make" placeholder="e.g. Mahindra" required
                            class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors" />
                    </div>
                    <div class="col-span-2 sm:col-span-1">
                        <label for="model" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">Model <span class="text-brand">*</span></label>
                        <input type="text" id="model" name="model" placeholder="e.g. Scorpio-N" required
                            class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors" />
                    </div>
                    <div class="col-span-2">
                        <label for="variant" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">Variant / Trim</label>
                        <input type="text" id="variant" name="variant" placeholder="e.g. Z8 L 4WD"
                            class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors" />
                    </div>
                    <div>
                        <label for="year" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">Year <span class="text-brand">*</span></label>
                        <input type="number" id="year" name="year" placeholder="2023" min="1990" max="2030" required
                            class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors" />
                    </div>
                    <div>
                        <label for="manufacturedDate" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">Manufactured date</label>
                        <input type="date" id="manufacturedDate" name="manufacturedDate"
                            class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors" />
                    </div>
                    <div>
                        <label for="referenceId" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">Reference ID <span class="text-zinc-400 normal-case">(auto-generated if blank)</span></label>
                        <input type="text" id="referenceId" name="referenceId" placeholder="e.g. AC2505"
                            class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors" />
                    </div>
                    <div>
                        <label for="bodyType" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">Body Type <span class="text-brand">*</span></label>
                        <select id="bodyType" name="bodyType"
                            class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors">
                            <option value="SUV">SUV</option>
                            <option value="Hatchback">Hatchback</option>
                            <option value="Sedan" selected>Sedan</option>
                            <option value="EV">Electric (EV)</option>
                            <option value="MUV">MUV</option>
                            <option value="Coupe">Coupe</option>
                            <option value="Convertible">Convertible</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- ── Section: Specs ──────────────────────────────────── -->
            <div class="mb-6 pt-6 border-t border-zinc-100 dark:border-zinc-800/60">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-1 h-5 bg-brand"></div>
                    <h3 class="font-mono font-bold text-[11px] text-zinc-500 uppercase tracking-widest">Specs &amp; Performance</h3>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label for="fuelType" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">Fuel Type <span class="text-brand">*</span></label>
                        <select id="fuelType" name="fuelType" required
                            class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors">
                            <option value="Petrol">Petrol</option>
                            <option value="Diesel">Diesel</option>
                            <option value="CNG">CNG</option>
                            <option value="Electric">Electric</option>
                            <option value="Hybrid">Hybrid</option>
                        </select>
                    </div>
                    <div>
                        <label for="transmission" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">Transmission <span class="text-brand">*</span></label>
                        <select id="transmission" name="transmission" required
                            class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors">
                            <option value="Manual">Manual</option>
                            <option value="Automatic">Automatic</option>
                        </select>
                    </div>
                    <div>
                        <label for="seats" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">Seating Capacity</label>
                        <input type="number" id="seats" name="seats" value="5" min="2" max="9"
                            class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors" />
                    </div>
                    <div>
                        <label for="mileage" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">Mileage (km) <span class="text-brand">*</span></label>
                        <input type="number" id="mileage" name="mileage" placeholder="e.g. 18500" min="0" required
                            class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors" />
                    </div>
                    <div>
                        <label for="engine" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">Engine</label>
                        <input type="text" id="engine" name="engine" placeholder="e.g. 2.4 L diesel"
                            class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors" />
                    </div>
                </div>
            </div>

            <!-- ── Section: Pricing ────────────────────────────────── -->
            <div class="mb-6 pt-6 border-t border-zinc-100 dark:border-zinc-800/60">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-1 h-5 bg-brand"></div>
                    <h3 class="font-mono font-bold text-[11px] text-zinc-500 uppercase tracking-widest">Pricing</h3>
                </div>
                <div>
                    <label for="price" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">Price (&#8377;) <span class="text-brand">*</span></label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-zinc-400 font-mono text-sm">&#8377;</span>
                        <input type="number" id="price" name="price" placeholder="2150000" min="1" required
                            class="w-full pl-7 pr-4 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors" />
                    </div>
                </div>
            </div>

            <!-- ── Section: Indian Market Details ─────────────────── -->
            <div class="mb-6 pt-6 border-t border-zinc-100 dark:border-zinc-800/60">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-1 h-5 bg-brand"></div>
                    <h3 class="font-mono font-bold text-[11px] text-zinc-500 uppercase tracking-widest">Indian Market Details</h3>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label for="ownership" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">Ownership</label>
                        <select id="ownership" name="ownership"
                            class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors">
                            <option value="1st Owner">1st Owner</option>
                            <option value="2nd Owner">2nd Owner</option>
                            <option value="3rd Owner">3rd Owner</option>
                            <option value="4th+ Owner">4th+ Owner</option>
                        </select>
                    </div>
                    <div>
                        <label for="rtoLocation" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">RTO Location</label>
                        <input type="text" id="rtoLocation" name="rtoLocation" placeholder="e.g. MH-02 Mumbai"
                            class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors" />
                    </div>
                    <div>
                        <label for="registrationState" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">Registration state</label>
                        <input type="text" id="registrationState" name="registrationState" placeholder="e.g. MP · Madhya Pradesh"
                            class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors" />
                    </div>
                    <div>
                        <label for="insuranceType" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">Insurance type</label>
                        <input type="text" id="insuranceType" name="insuranceType" placeholder="e.g. Comprehensive"
                            class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors" />
                    </div>
                    <div>
                        <label for="extColor" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">Exterior Color</label>
                        <input type="text" id="extColor" name="extColor" placeholder="e.g. Napoli Black"
                            class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors" />
                    </div>
                    <div>
                        <label for="intColor" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">Interior Color</label>
                        <input type="text" id="intColor" name="intColor" placeholder="e.g. Rich Tan &amp; Coffee Black"
                            class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors" />
                    </div>
                </div>
            </div>

            <!-- ── Section: Description ────────────────────────────── -->
            <div class="mb-6 pt-6 border-t border-zinc-100 dark:border-zinc-800/60">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-1 h-5 bg-brand"></div>
                    <h3 class="font-mono font-bold text-[11px] text-zinc-500 uppercase tracking-widest">Description</h3>
                </div>
                <textarea id="description" name="description" rows="4"
                    placeholder="Describe condition, service history, special features, accident history..."
                    class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm resize-none rounded-none transition-colors"></textarea>
            </div>

            <!-- ── Section: Feature Highlights ────────────────────── -->
            <div class="mb-6 pt-6 border-t border-zinc-100 dark:border-zinc-800/60">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-1 h-5 bg-brand"></div>
                    <h3 class="font-mono font-bold text-[11px] text-zinc-500 uppercase tracking-widest">Feature Highlights</h3>
                </div>
                <div class="grid grid-cols-2 gap-3">
                    <label for="add_sunroof" class="flex items-center gap-3 cursor-pointer group p-3 border border-zinc-100 dark:border-zinc-800 hover:border-brand/40 transition-colors">
                        <input type="checkbox" id="add_sunroof" name="featSunroof"
                            class="w-4 h-4 rounded-none bg-zinc-100 dark:bg-zinc-900 border-zinc-300 dark:border-zinc-700 text-brand focus:ring-brand focus:ring-offset-0 focus:ring-1" />
                        <span class="font-mono text-[10px] text-zinc-950 dark:text-white uppercase tracking-widest group-hover:text-brand transition-colors">&#9728; Sunroof</span>
                    </label>
                    <label for="add_alloyWheels" class="flex items-center gap-3 cursor-pointer group p-3 border border-zinc-100 dark:border-zinc-800 hover:border-brand/40 transition-colors">
                        <input type="checkbox" id="add_alloyWheels" name="featAlloyWheels"
                            class="w-4 h-4 rounded-none bg-zinc-100 dark:bg-zinc-900 border-zinc-300 dark:border-zinc-700 text-brand focus:ring-brand focus:ring-offset-0 focus:ring-1" />
                        <span class="font-mono text-[10px] text-zinc-950 dark:text-white uppercase tracking-widest group-hover:text-brand transition-colors">&#9881; Alloy Wheels</span>
                    </label>
                    <label for="add_touchscreen" class="flex items-center gap-3 cursor-pointer group p-3 border border-zinc-100 dark:border-zinc-800 hover:border-brand/40 transition-colors">
                        <input type="checkbox" id="add_touchscreen" name="featTouchscreen"
                            class="w-4 h-4 rounded-none bg-zinc-100 dark:bg-zinc-900 border-zinc-300 dark:border-zinc-700 text-brand focus:ring-brand focus:ring-offset-0 focus:ring-1" />
                        <span class="font-mono text-[10px] text-zinc-950 dark:text-white uppercase tracking-widest group-hover:text-brand transition-colors">&#128250; Touchscreen</span>
                    </label>
                    <label for="add_reverseCamera" class="flex items-center gap-3 cursor-pointer group p-3 border border-zinc-100 dark:border-zinc-800 hover:border-brand/40 transition-colors">
                        <input type="checkbox" id="add_reverseCamera" name="featReverseCamera"
                            class="w-4 h-4 rounded-none bg-zinc-100 dark:bg-zinc-900 border-zinc-300 dark:border-zinc-700 text-brand focus:ring-brand focus:ring-offset-0 focus:ring-1" />
                        <span class="font-mono text-[10px] text-zinc-950 dark:text-white uppercase tracking-widest group-hover:text-brand transition-colors">&#128247; Reverse Camera</span>
                    </label>
                </div>
                <div class="mt-4">
                    <label for="equipment" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">Equipment list</label>
                    <input type="text" id="equipment" name="equipment" placeholder="ABS, airbags, alloy wheels, Bluetooth"
                        class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors" />
                    <p class="mt-1 font-mono text-[10px] text-zinc-400">Separate equipment items with commas.</p>
                </div>
            </div>

            <!-- ── Section: Images ─────────────────────────────────── -->
            <div class="mb-6 pt-6 border-t border-zinc-100 dark:border-zinc-800/60">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-1 h-5 bg-brand"></div>
                    <h3 class="font-mono font-bold text-[11px] text-zinc-500 uppercase tracking-widest">Car Images</h3>
                </div>
                <input type="file" id="images" name="images" multiple accept="image/jpeg,image/png,image/webp,image/avif"
                    class="hidden" onchange="previewImages(event)" />
                <button type="button" onclick="document.getElementById('images').click()"
                    class="w-full py-8 border-2 border-dashed border-zinc-200 dark:border-zinc-700 hover:border-brand hover:bg-brand/5 transition-colors text-center group mb-3">
                    <svg class="w-8 h-8 mx-auto mb-2 text-zinc-300 dark:text-zinc-600 group-hover:text-brand transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    <span class="font-mono text-[10px] text-zinc-400 uppercase tracking-widest group-hover:text-brand transition-colors">
                        Click to upload — JPG, PNG, WebP up to 10MB each (max 10 images)
                    </span>
                </button>
                <div id="image-preview-grid" class="grid grid-cols-5 gap-2"></div>
            </div>

            <!-- ── Section: Visibility & Status ───────────────────── -->
            <div class="mb-6 pt-6 border-t border-zinc-100 dark:border-zinc-800/60">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-1 h-5 bg-brand"></div>
                    <h3 class="font-mono font-bold text-[11px] text-zinc-500 uppercase tracking-widest">Visibility &amp; Status</h3>
                </div>
                <div class="grid grid-cols-2 gap-4 mb-4">
                    <div class="col-span-2 sm:col-span-1">
                        <label for="status" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">
                            Listing Status <span class="text-brand">*</span>
                        </label>
                        <select id="status" name="status"
                            class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors">
                            <option value="Available">Available</option>
                            <option value="Sold">Sold</option>
                        </select>
                    </div>
                </div>
                <label for="isFeatured" class="flex items-center gap-3 cursor-pointer group">
                    <input type="checkbox" id="isFeatured" name="isFeatured"
                        class="w-5 h-5 rounded-none bg-zinc-100 dark:bg-zinc-900 border-zinc-300 dark:border-zinc-700 text-brand focus:ring-brand focus:ring-offset-0 focus:ring-1" />
                    <div>
                        <span class="font-bold text-xs text-zinc-950 dark:text-white uppercase tracking-widest group-hover:text-brand transition-colors">Feature on Homepage</span>
                        <p class="font-mono text-[10px] text-zinc-400 mt-0.5">Car will appear in the featured section</p>
                    </div>
                </label>
            </div>

            <!-- ── Form Actions ────────────────────────────────────── -->
            <div class="pt-6 border-t border-zinc-200 dark:border-zinc-800 flex gap-3">
                <button type="submit" id="submit-add-btn"
                    class="flex-1 py-3.5 bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 font-bold uppercase tracking-widest text-xs hover:bg-brand dark:hover:bg-brand dark:hover:text-white transition-colors">
