    <!-- ═══════════════════════════════════════════════════════════
     DELETE CONFIRM MODAL
    ══════════════════════════════════════════════════════════════ -->
    <div id="deleteModal"
        class="fixed inset-0 z-[60] hidden items-center justify-center bg-zinc-950/90 backdrop-blur-sm p-4">
        <div class="bg-white dark:bg-[#0a0a0a] border border-zinc-200 dark:border-zinc-800 p-8 max-w-sm w-full shadow-2xl relative">
            <div class="absolute top-0 left-0 w-full h-1 bg-red-600"></div>
            <div class="text-center">
                <div class="w-14 h-14 border border-red-600 flex items-center justify-center mx-auto mb-5 bg-red-600/5">
                    <svg class="w-7 h-7 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                </div>
                <h3 class="font-display font-black text-xl text-zinc-950 dark:text-white uppercase tracking-tighter mb-3">
                    Confirm Deletion
                </h3>
                <p class="text-zinc-500 font-mono text-[11px] uppercase tracking-widest mb-2 leading-relaxed">
                    Permanently delete:
                </p>
                <p id="deleteCarName" class="font-bold text-zinc-950 dark:text-white font-mono text-sm mb-6"></p>
                <p class="text-zinc-400 font-mono text-[10px] mb-6 leading-relaxed">
                    All Cloudinary images will also be permanently removed. This cannot be undone.
                </p>
                <div class="flex gap-3">
                    <button onclick="closeDeleteModal()"
                        class="flex-1 py-3 border border-zinc-200 dark:border-zinc-800 text-zinc-500 font-bold uppercase tracking-widest text-[10px] hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors">
                        Cancel
                    </button>
                    <button id="confirmDeleteBtn"
                        class="flex-1 py-3 bg-red-600 text-white font-bold uppercase tracking-widest text-[10px] hover:bg-red-700 transition-colors flex items-center justify-center gap-2">
                        <svg id="deleteSpinner" class="w-3 h-3 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                        </svg>
                        Delete Forever
                    </button>
                </div>
            </div>
        </div>
    </div>
