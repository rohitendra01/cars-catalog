            <!-- Pricing -->
            <div class="mb-6 pt-6 border-t border-zinc-100 dark:border-zinc-800/60">
                <div class="flex items-center gap-3 mb-4">
                    <div class="w-1 h-5 bg-brand"></div>
                    <h3 class="font-mono font-bold text-[11px] text-zinc-500 uppercase tracking-widest">Pricing</h3>
                </div>
                <div>
                    <label for="fPrice" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">
                        Price (&#8377;) <span class="text-brand">*</span>
                    </label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-zinc-400 font-mono text-sm">&#8377;</span>
                        <input type="number" id="fPrice" name="price" placeholder="2150000" min="1" required
                            class="w-full pl-7 pr-4 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors" />
                    </div>
                    <p id="pricePreview" class="mt-1 font-mono text-[10px] text-zinc-400"></p>
                </div>

                <!-- CRO: Market Value (Strike-through anchor price) -->
                <div class="mt-4">
                    <label for="fMarketValue" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">
                        Market Value (&#8377;) <span class="text-zinc-400 font-normal normal-case">— shown as strike-through</span>
                    </label>
                    <div class="relative">
                        <span class="absolute left-3 top-1/2 -translate-y-1/2 text-zinc-400 font-mono text-sm">&#8377;</span>
                        <input type="number" id="fMarketValue" name="market_value" placeholder="Leave empty to hide" min="0"
                            class="w-full pl-7 pr-4 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors" />
                    </div>
                    <p class="mt-1 font-mono text-[10px] text-zinc-400">If set higher than price, savings badge will appear automatically.</p>
                </div>

                <!-- CRO: Discount Tag -->
                <div class="mt-4">
                    <label for="fDiscountTag" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">
                        Deal Badge <span class="text-zinc-400 font-normal normal-case">— e.g. "Exceptional Deal"</span>
                    </label>
                    <input type="text" id="fDiscountTag" name="discount_tag" placeholder="Leave empty to hide"
                        class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-brand focus:ring-1 focus:ring-brand font-mono text-sm rounded-none transition-colors" />
                </div>

                <div class="mt-4">
                    <label for="fReservationStatus" class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-1.5">Reservation status</label>
                    <select id="fReservationStatus" name="reservation_status" class="w-full px-3 py-2.5 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white font-mono text-sm">
                        <option value="">Not reserved</option>
                        <option value="Available">Available</option>
                        <option value="Reserved">Reserved</option>
                    </select>
                </div>
            </div>
