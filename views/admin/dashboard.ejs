<%- include('../partials/head-admin', { pageTitle: 'Admin Panel | AutoVault India' }) %>

<%- include('../partials/admin-topbar', { showAddBtn: true }) %>

<!-- ═══════════════════════════════════════════════════════════
 MAIN CONTENT
══════════════════════════════════════════════════════════════ -->
<main class="admin-main flex-1 pt-16 pb-16 max-w-[1920px] mx-auto w-full">
    <div class="admin-content px-4 sm:px-6 lg:px-10 py-8">

        <!-- Page Heading -->
        <header class="admin-page-header mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
            <div>
                <p class="section-eyebrow">AUTOVAULT / INVENTORY</p>
                <h1 class="font-display font-black text-3xl sm:text-4xl text-zinc-950 dark:text-white uppercase tracking-tighter mb-1">
                    Vehicle inventory
                </h1>
                <p id="inventorySubtitle" class="text-zinc-400 font-mono text-[11px] uppercase tracking-widest">
                    Loading inventory…
                </p>
            </div>
            <button onclick="openPanel()" id="addBtnDesktop"
                class="hidden sm:flex items-center gap-2 px-6 py-3 bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 font-bold uppercase tracking-widest text-xs hover:bg-brand dark:hover:bg-brand dark:hover:text-white transition-colors whitespace-nowrap">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                </svg>
                Add New Car
            </button>
        </header>

        <!-- Stats Strip -->
        <section aria-label="Inventory overview">
            <%- include('./_stats-strip') %>
        </section>

        <!-- Filters & Search Toolbar -->
        <section aria-label="Search and filter inventory">
            <%- include('./_filters-toolbar') %>
        </section>

        <!-- Car Table -->
        <section aria-label="Vehicle listings">
            <%- include('./_car-table') %>
        </section>

    </div>
</main>

<!-- Slide-out Panel (Overlay + Form) -->
<%- include('./_slide-panel') %>

<!-- Delete Confirm Modal -->
<%- include('./_delete-modal') %>

<%- include('../partials/admin-footer') %>
