                <button id="confirmDeleteBtn"
                    class="flex-1 py-3 bg-red-600 text-white font-bold uppercase tracking-widest text-[10px] hover:bg-red-700 transition-colors flex items-center justify-center gap-2">
                    <svg id="deleteSpinner" class="w-3 h-3 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/>
                    </svg>
                    Delete Forever
                </button>
            </div>
        </div>
    </div>
</div>

