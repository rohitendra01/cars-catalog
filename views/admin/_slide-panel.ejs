    <!-- ═══════════════════════════════════════════════════════════
     BACKGROUND OVERLAY
    ══════════════════════════════════════════════════════════════ -->
    <div id="overlay" class="overlay fixed inset-0 bg-zinc-950/80 backdrop-blur-sm z-50" onclick="closePanel()"></div>

    <!-- ═══════════════════════════════════════════════════════════
     SLIDE-OUT PANEL — Car Create / Edit
    ══════════════════════════════════════════════════════════════ -->
    <div id="slidePanel"
        class="slide-panel fixed top-0 right-0 h-full w-full sm:w-[620px] bg-white dark:bg-[#0a0a0a] border-l border-zinc-200 dark:border-zinc-800 z-50 overflow-y-auto flex flex-col">

        <!-- Panel Header -->
        <div class="sticky top-0 z-10 bg-white dark:bg-[#0a0a0a] flex items-center justify-between px-6 py-4 border-b border-zinc-200 dark:border-zinc-800">
            <div>
                <h2 id="panelTitle" class="font-display font-black text-xl text-zinc-950 dark:text-white uppercase tracking-tighter">
                    Add New Car
                </h2>
                <p id="panelSubtitle" class="font-mono text-[10px] text-zinc-400 uppercase tracking-widest mt-0.5">
                    Fill in all required fields
                </p>
            </div>
            <button onclick="closePanel()" aria-label="Close panel"
                class="p-2 border border-zinc-200 dark:border-zinc-700 text-zinc-500 hover:text-white hover:bg-zinc-950 dark:hover:bg-white dark:hover:text-zinc-950 transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <!-- Panel Form -->
        <form id="carForm" enctype="multipart/form-data" class="flex-1 px-6 py-6 space-y-0" novalidate>
            <input type="hidden" id="editCarId" value="" />

            <!-- ── Vehicle Identity ──────────────────────────────── -->
            <%- include('./_panel-section-identity') %>

            <!-- ── Specs & Performance ──────────────────────────── -->
            <%- include('./_panel-section-specs') %>

            <!-- ── Pricing ──────────────────────────────────────── -->
            <%- include('./_panel-section-pricing') %>

            <!-- ── Indian Market Details ────────────────────────── -->
            <%- include('./_panel-section-market') %>

            <!-- ── Description ──────────────────────────────────── -->
            <%- include('./_panel-section-description') %>

            <!-- ── Feature Highlights ──────────────────────────── -->
            <%- include('./_panel-section-features') %>

            <!-- ── Images ───────────────────────────────────────── -->
            <%- include('./_panel-section-images') %>

            <!-- ── Visibility ───────────────────────────────────── -->
            <%- include('./_panel-section-visibility') %>

            <!-- ── Form Actions ──────────────────────────────────── -->
            <div class="sticky bottom-0 pt-4 mt-4 border-t border-zinc-200 dark:border-zinc-800 bg-white dark:bg-[#0a0a0a] flex gap-3 pb-6">
                <button type="submit" id="submitBtn"
                    class="flex-1 py-3.5 bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 font-bold uppercase tracking-widest text-xs hover:bg-brand dark:hover:bg-brand dark:hover:text-white transition-colors flex items-center justify-center gap-2">
                    <svg id="submitSpinner" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" />
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z" />
                    </svg>
                    <span id="submitBtnText">Save Car Listing</span>
                </button>
                <button type="button" onclick="closePanel()"
                    class="px-6 py-3.5 bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-600 dark:text-zinc-400 font-bold uppercase tracking-widest text-xs hover:bg-zinc-200 dark:hover:bg-zinc-800 transition-colors">
                    Cancel
                </button>
            </div>
        </form>
    </div>
