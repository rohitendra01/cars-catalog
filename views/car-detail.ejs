                <script>
                    const CAR_PRICE = <%= hasPrice ?currentPrice: 0 %>;
                    const CAR_HAS_PRICE = <%= hasPrice ? 'true' : 'false' %>;

                    /* ── Gallery ─────────────────────────────────────────────── */
                    function selectVehiclePhoto(button) {
                        const thumbnails = Array.from(document.querySelectorAll('.gallery-thumbnails .thumbnail'));
                        const index = thumbnails.indexOf(button);
                        switchImage(button.dataset.fullSrc, button);
                        const counter = document.querySelector('.gallery-count');
                        if (counter && index >= 0) {
                            counter.textContent = `${String(index + 1).padStart(2, '0')} / ${String(thumbnails.length).padStart(2, '0')}`;
                        }
                        const mainImage = document.getElementById('pdp-main-img');
                        const title = document.querySelector('.vehicle-heading h1')?.textContent || '';
                        if (mainImage && index >= 0) mainImage.alt = `${title} — photo ${index + 1} of ${thumbnails.length}`;
                    }

                    /* ── WhatsApp Enquiry ─────────────────────────────────────── */
                    const COMPANY_PHONE = '919516486666';
                    const CAR_MAKE = <%- safeJson(car.make || '') %>;
                    const CAR_MODEL = <%- safeJson(car.model || '') %>;
                    const CAR_YEAR = <%- safeJson(car.year || '') %>;
                    const CAR_REF = <%- safeJson(referenceLabel) %>;
                    const CAR_PAGE_URL = (typeof absoluteCarUrl !== 'undefined' && absoluteCarUrl)
                        ? absoluteCarUrl
                        : window.location.href;

                    function buildWhatsAppUrl() {
                        const name = (document.getElementById('enq-name')?.value || '').trim();
                        const phone = (document.getElementById('enq-phone')?.value || '').trim();
                        const budgetRaw = document.getElementById('enq-budget')?.value;
                        const budget = budgetRaw ? Number(budgetRaw).toLocaleString('en-IN') : '';
                        const purchaseType = document.querySelector('input[name="purchaseType"]:checked')?.value || '';
                        const customer = [name, phone].filter(Boolean).join(' · ');
                        const notes = (document.getElementById('enq-notes')?.value || '').trim();

                        const lines = [
                            `Hi The Auto Choice! I'm interested in the following car:`,
                            ``,
                            `🚗 *Car:* ${CAR_MAKE} ${CAR_MODEL} (${CAR_YEAR})`,
                            `🔖 *Ref:* ${CAR_REF}`,
                            `🔗 *Link:* ${CAR_PAGE_URL}`,
                            ``,
                            budget ? `💰 *Budget:* ₹${budget}` : null,
                            purchaseType ? `💳 *Payment Type:* ${purchaseType}` : null,
                            customer ? `👤 *Customer:* ${customer}` : null,
                            notes ? `📝 *Notes:* ${notes}` : null
                        ].filter(l => l !== null).join('\n');

                        return `https://wa.me/${COMPANY_PHONE}?text=${encodeURIComponent(lines)}`;
                    }

                    function handleEnquiry(event) {
                        event.preventDefault();
                        window.open(buildWhatsAppUrl(), '_blank', 'noopener,noreferrer');
                    }

                    function mobileWhatsAppClick(event) {
                        event.preventDefault();
                        window.open(buildWhatsAppUrl(), '_blank', 'noopener,noreferrer');
                    }

                    /* Vehicle history helper – now targets enquiry form */
                    function requestCarHistoryReport(event) {
                        event.preventDefault();
                        document.querySelector('.enquiry-extras')?.setAttribute('open', '');
                        const notesEl = document.getElementById('enq-notes');
                        if (notesEl && !notesEl.value.includes('Vehicle History')) {
                            notesEl.value = (notesEl.value ? notesEl.value + '\n' : '') + 'Please share the Vehicle History Report.';
                        }
                        const form = document.getElementById('enquiry-form');
                        if (form) form.scrollIntoView({ behavior: 'smooth', block: 'start' });

                    }

                    function requestTestDrive(event) {
                        event.preventDefault();
                        document.querySelector('.enquiry-extras')?.setAttribute('open', '');
                        const notesEl = document.getElementById('enq-notes');
                        if (notesEl && !notesEl.value.toLowerCase().includes('test drive')) {
                            notesEl.value = (notesEl.value ? notesEl.value + '\n' : '') + 'I would like to book a test drive.';
                        }
                        const form = document.getElementById('enquiry-form');
                        if (form) form.scrollIntoView({ behavior: 'smooth', block: 'start' });

                    }

                    document.addEventListener('DOMContentLoaded', () => {
                        if (CAR_HAS_PRICE) calculateEMI();
                        initShortlistButtons();
                    });
                </script>

