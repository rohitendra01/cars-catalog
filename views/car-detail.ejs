<!DOCTYPE html>
<html lang="en">
<%
    const vehicleName = [car.year, car.make, car.model, car.variant].filter(Boolean).join(' ');
    const mileageLabel = Number(car.mileage || car.odometer || 0).toLocaleString('en-IN');
    const referenceLabel = car.referenceId || (car._id ? `AC${String(car._id).slice(-8).toUpperCase()}` : '—');
    const registrationLabel = car.registrationState || car.rtoLocation || car.rto || '';
    const galleryImages = (car.images || []).map(image => typeof image === 'string' ? image : image.url).filter(Boolean);
    const currentPrice = Number(car.croPricing && car.croPricing.current_price !== undefined ? car.croPricing.current_price : car.price || 0);
    const savingsAmount = Number(car.croPricing && car.croPricing.savings_amount || 0);
    const anchorPrice = Number(car.croPricing && car.croPricing.anchor_price || car.market_value || car.price || 0);
    const anchorLabel = car.croPricing && car.croPricing.anchor_label || 'Market Value';
    const lakhPrice = (currentPrice / 100000).toFixed(2);
    const rupeePrice = currentPrice.toLocaleString('en-IN');
    const manufactureDate = car.manufacturedDate && !Number.isNaN(new Date(car.manufacturedDate).getTime())
        ? new Intl.DateTimeFormat('en-IN', { month: 'long', year: 'numeric' }).format(new Date(car.manufacturedDate))
        : '';
    const legacyFeatureNames = { sunroof: 'Sunroof', alloyWheels: 'Alloy wheels', touchscreen: 'Touchscreen', reverseCamera: 'Rear parking camera' };
    const equipmentItems = Array.from(new Map([
        ...(Array.isArray(car.equipment) ? car.equipment : []),
        ...Object.entries(car.features || {}).filter(([key, enabled]) => enabled && legacyFeatureNames[key]).map(([key]) => legacyFeatureNames[key])
    ].map(item => String(item || '').trim()).filter(Boolean).map(item => [item.toLowerCase(), item])).values());
    const highlightItems = [
        car.ownership || '',
        car.seats ? `${car.seats} seats` : '',
        car.insuranceType ? `${car.insuranceType} insurance` : '',
        car.engine || '',
        ...equipmentItems.slice(0, 2)
    ].filter(Boolean).slice(0, 4);
    const specificationItems = [
        ['Make', car.make],
        ['Model', car.model],
        ['Variant', car.variant],
        ['Model year', car.year],
        ['Manufactured', manufactureDate],
        ['Odometer', `${mileageLabel} km`],
        ['Fuel', car.fuelType],
        ['Transmission', car.transmission],
        ['Engine', car.engine],
        ['Body type', car.bodyType],
        ['Seats', car.seats],
        ['Colour', car.extColor],
        ['Interior colour', car.intColor],
        ['Ownership', car.ownership],
        ['Registration', registrationLabel],
        ['Insurance', car.insuranceType],
        ['Photographs', galleryImages.length || ''],
        ['Reference', referenceLabel]
    ].filter(([, value]) => value !== undefined && value !== null && String(value).trim() !== '');
    const whatsappMessage = encodeURIComponent(`Hi The Auto Choice, I’m interested in the ${vehicleName} listed for ₹${rupeePrice} (ref ${referenceLabel}). Could you please share more details? ${typeof absoluteCarUrl !== 'undefined' ? absoluteCarUrl : ''}`);
    const whatsappUrl = `https://wa.me/919516486666?text=${whatsappMessage}`;
    const structuredData = {
        '@context': 'https://schema.org',
        '@type': 'Car',
        name: vehicleName,
        image: galleryImages,
        description: car.description || `${vehicleName} listed by The Auto Choice. Contact the showroom to confirm current availability and arrange a viewing.`,
        brand: { '@type': 'Brand', name: car.make },
        model: car.model,
        vehicleModelDate: String(car.year),
        mileageFromOdometer: { '@type': 'QuantitativeValue', value: Number(car.mileage || 0), unitCode: 'KMT' },
        fuelType: car.fuelType,
        vehicleTransmission: car.transmission,
        offers: {
            '@type': 'Offer',
            price: currentPrice,
            priceCurrency: 'INR',
            availability: car.status === 'Sold' || car.reservation_status === 'Reserved' ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
            url: typeof canonicalUrl !== 'undefined' ? canonicalUrl : `/inventory/${car.slug || car._id}`
        }
    };
%>
<%- include('partials/head-public', {
    pageTitle: `${vehicleName} | The Auto Choice`,
    metaDescription: `Explore this ${vehicleName}: ${mileageLabel} km, ${car.fuelType || 'fuel details on request'}, ${car.transmission || 'transmission details on request'}. View photos, specifications and equipment.`,
    canonicalUrl: `/inventory/${car.slug || car._id}`,
    ogImage: galleryImages[0] || car.primaryImage,
    pageStylesheet: '/css/car-detail.css'
}) %>
<body data-vehicle-id="<%= car._id %>">
<%- include('partials/navbar', { isAdmin: typeof isAdmin !== 'undefined' && isAdmin }) %>

<main class="vehicle-detail-page" id="main">
    <div class="container vehicle-detail-container">
        <nav class="vehicle-breadcrumbs" aria-label="Breadcrumb">
            <ol>
                <li><a href="/">Home</a></li>
                <li aria-hidden="true">/</li>
                <li><a href="/inventory">Cars for sale</a></li>
                <% if (car.bodyType) { %>
                    <li aria-hidden="true">/</li>
                    <li><a href="/inventory?body=<%= encodeURIComponent(car.bodyType) %>"><%= car.bodyType %>s</a></li>
                <% } %>
                <li aria-hidden="true">/</li>
                <li aria-current="page"><%= car.make %> <%= car.model %></li>
            </ol>
        </nav>

        <header class="vehicle-heading">
            <div class="vehicle-heading-copy">
                <div class="vehicle-kicker-row">
                    <span class="vehicle-make"><%= car.make %></span>
                    <span class="vehicle-year"><%= car.year %></span>
                    <span class="vehicle-reference">Ref <strong><%= referenceLabel %></strong></span>
                </div>
                <h1><%= vehicleName %></h1>
                <p class="vehicle-subline">
                    <span><%= mileageLabel %> km</span><span><%= car.fuelType %></span><span><%= car.transmission %></span>
                    <% if (car.seats) { %><span><%= car.seats %> seats</span><% } %>
                    <% if (car.ownership) { %><span><%= car.ownership %></span><% } %>
                </p>
            </div>
            <div class="vehicle-heading-price" aria-label="Vehicle price">
                <% if (savingsAmount > 0) { %>
                <span class="cro-market-price-label"><%= anchorLabel %></span>
                <span class="cro-market-price">₹<%= (anchorPrice / 100000).toFixed(2) %> Lakh</span>
                <span class="cro-today-label">Today's Exclusive Price</span>
                <% } else { %>
                <span class="price-caption">Asking price</span>
                <% } %>
                <strong>₹<%= lakhPrice %> <small>Lakh</small></strong>
                <span class="exact-price">₹<%= rupeePrice %></span>
                <% if (savingsAmount > 0) { %>
                <div class="cro-savings-badge">↓ ₹<%= savingsAmount.toLocaleString('en-IN') %> Below Market Value</div>
                <% } %>
                <% if (car.discount_tag) { %>
                <div class="cro-deal-badge" style="margin-top: 6px;">
                    <% if (car.discount_tag && !isNaN(Number(car.discount_tag))) { %>
                        ↓ ₹<%= Number(car.discount_tag).toLocaleString('en-IN') %> Discount
                    <% } else { %>
                        <%= car.discount_tag || 'Featured Deal' %>
                    <% } %>
                </div>
                <% } %>
            </div>
        </header>

        <div class="vehicle-page-grid">
            <div class="vehicle-main-column">
                <section class="vehicle-gallery card-surface" aria-label="Vehicle photographs">
                    <% if (galleryImages.length) { %>
                        <div class="gallery-stage">
                            <img id="pdp-main-img" class="gallery-main-image" src="<%= galleryImages[0] %>" alt="<%= vehicleName %> — photo 1 of <%= galleryImages.length %>" fetchpriority="high">
                            <span class="gallery-count"><%= String(1).padStart(2, '0') %> / <%= String(galleryImages.length).padStart(2, '0') %></span>
                        </div>
                        <% if (galleryImages.length > 1) { %>
                            <div class="gallery-thumbnails" aria-label="Choose a vehicle photo">
                                <% galleryImages.forEach((imageUrl, index) => { %>
                                    <button type="button" class="thumbnail <%= index === 0 ? 'active' : '' %>" onclick="selectVehiclePhoto(this)" data-full-src="<%= imageUrl %>" aria-label="Show photo <%= index + 1 %> of <%= galleryImages.length %>">
                                        <img src="<%= imageUrl %>" alt="" loading="lazy">
                                    </button>
                                <% }) %>
                            </div>
                        <% } %>
                    <% } else { %>
                        <div class="gallery-empty" role="img" aria-label="Vehicle photos coming soon">
                            <span class="gallery-empty-icon" aria-hidden="true">▧</span>
                            <strong>Vehicle photos coming soon</strong>
                            <span>Contact us to arrange a viewing.</span>
                        </div>
                    <% } %>
                </section>

                <section class="quick-overview card-surface" aria-label="Key vehicle details">
                    <% const quickItems = [
                        ['Odometer', `${mileageLabel} km`],
                        ['Year', car.year],
                        ['Fuel', car.fuelType],
                        ['Gearbox', car.transmission],
                        ['Seats', car.seats],
                        ['Owner', car.ownership]
                    ]; %>
                    <% quickItems.forEach(([label, value]) => { %>
                        <div class="quick-item">
                            <span class="quick-label"><%= label %></span>
                            <strong><%= value || '—' %></strong>
                        </div>
                    <% }) %>
                </section>

                <section class="detail-section card-surface" aria-labelledby="about-title">
                    <div class="section-heading">
                        <span class="section-eyebrow">Vehicle overview</span>
                        <h2 id="about-title">About this car</h2>
                    </div>
                    <p class="vehicle-description"><%= car.description || `Explore the listed details for this ${vehicleName}. Speak with The Auto Choice to confirm current availability and arrange a viewing.` %></p>
                    <% if (highlightItems.length) { %>
                        <ul class="highlight-list" aria-label="Vehicle highlights">
                            <% highlightItems.forEach(item => { %>
                                <li><span class="highlight-check" aria-hidden="true">✓</span><%= item %></li>
                            <% }) %>
                        </ul>
                    <% } %>
                </section>

                <section class="detail-section card-surface" aria-labelledby="specifications-title">
                    <div class="section-heading">
                        <span class="section-eyebrow">At a glance</span>
                        <h2 id="specifications-title">Specifications</h2>
                    </div>
                    <dl class="specification-grid">
                        <% specificationItems.forEach(([label, value]) => { %>
                            <div class="specification-item">
                                <dt><%= label %></dt>
                                <dd><%= value %><%= label === 'Photographs' ? ' photos' : '' %></dd>
                            </div>
                        <% }) %>
                    </dl>
                    <p class="specification-note">Details are provided as listed by The Auto Choice. Please confirm anything important when you see the car.</p>
                </section>

                <section class="detail-section card-surface" aria-labelledby="equipment-title">
                    <div class="section-heading">
                        <span class="section-eyebrow">Included with this vehicle</span>
                        <h2 id="equipment-title">Equipment</h2>
                    </div>
                    <% if (equipmentItems.length) { %>
                        <ul class="equipment-grid">
                            <% equipmentItems.forEach(item => { %>
                                <li><span class="equipment-check" aria-hidden="true">✓</span><%= item %></li>
                            <% }) %>
                        </ul>
                    <% } else { %>
                        <p class="empty-equipment">Equipment details haven’t been added yet. Contact us and we’ll be happy to confirm.</p>
                    <% } %>
                </section>

                <section class="detail-section test-drive-section card-surface" id="test-drive-form" aria-labelledby="test-drive-title">
                    <div class="section-heading">
                        <span class="section-eyebrow">Come see it in person</span>
                        <h2 id="test-drive-title">Book a test drive</h2>
                    </div>
                    <p>Leave your details and our team will help arrange a visit.</p>
                    <form class="test-drive-form" onsubmit="handleTestDrive(event)">
                        <input type="hidden" id="td-inquiry-type" value="Schedule Visit">
                        <input type="hidden" id="td-message" value="">
                        <div class="form-group">
                            <label for="td-name">Your name</label>
                            <input type="text" id="td-name" name="name" placeholder="Full name" autocomplete="name" required>
                        </div>
                        <div class="form-group">
                            <label for="td-phone">Mobile number</label>
                            <input type="tel" id="td-phone" name="phone" placeholder="+91 mobile number" autocomplete="tel" required>
                        </div>
                        <div class="form-group">
                            <label for="td-city">City or pincode</label>
                            <input type="text" id="td-city" name="city" placeholder="City / Pincode" autocomplete="postal-code" required>
                        </div>
                        <button class="button button-primary" type="submit" id="schedule-btn">
                            <svg class="test-drive-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M7 3v3M17 3v3M4 9h16" />
                                <rect x="4" y="5" width="16" height="16" rx="2" />
                                <path d="m9 15 2 2 4-4" />
                            </svg>
                            <span class="test-drive-button-label">Request a test drive</span>
                        </button>
                    </form>
                </section>
            </div>

            <aside class="vehicle-sidebar" aria-label="Price and enquiry">
                <div class="vehicle-action-card card-surface" style="display: flex; flex-direction: column; gap: 20px;">
                    <!-- Top section: Status and Price -->
                    <div>
                        <div class="sidebar-status <%= car.status === 'Sold' ? 'is-sold' : car.reservation_status === 'Reserved' ? 'is-reserved' : '' %>" style="padding-bottom: 12px; border-bottom: 1px solid var(--detail-line); margin-bottom: 12px;">
                            <span></span><%= car.status === 'Sold' ? 'Recently sold' : car.reservation_status === 'Reserved' ? 'Currently reserved' : 'Enquire about this car' %>
                        </div>
                        <div class="sidebar-price" style="padding: 0;">
                            <% if (savingsAmount > 0) { %>
                            <span class="cro-market-price-label"><%= anchorLabel %></span>
                            <span class="cro-market-price">₹<%= anchorPrice.toLocaleString('en-IN') %></span>
                            <span class="cro-today-label">Today's Exclusive Price</span>
                            <% } else { %>
                            <span>Price</span>
                            <% } %>
                            <strong>₹<%= lakhPrice %> <small>Lakh</small></strong>
                            <span class="exact-price">₹<%= rupeePrice %></span>
                            
                            <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 12px;">
                                <% if (savingsAmount > 0) { %>
                                <div class="cro-savings-badge" style="margin-top: 0; width: fit-content;">↓ ₹<%= savingsAmount.toLocaleString('en-IN') %> Below Market</div>
                                <% } %>
                                <% if (car.discount_tag) { %>
                                <div class="cro-deal-badge" style="width: fit-content; margin-top: 0;">
                                    <% if (!isNaN(Number(car.discount_tag))) { %>
                                        ↓ ₹<%= Number(car.discount_tag).toLocaleString('en-IN') %> Discount
                                    <% } else { %>
                                        <%= car.discount_tag %>
                                    <% } %>
                                </div>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <!-- Middle section: Deal Info (EMI, Reserve) -->
                    <div style="display: flex; flex-direction: column; gap: 12px; padding-top: 16px; border-top: 1px solid var(--detail-line);">
                        <%
                            const emiAmount = Number(car.croPricing && car.croPricing.monthly_estimate || 0);
                        %>
                        <% if (emiAmount > 0) { %>
                        <div class="cro-emi-teaser" style="margin-top: 0;">
                            As low as <strong>₹<%= emiAmount.toLocaleString('en-IN') %>/mo</strong> with zero down
                            <button class="cro-calc-link" type="button" onclick="document.querySelector('.finance-calc').open=true;document.querySelector('.finance-calc').scrollIntoView({behavior:'smooth'})">Calculate Financing →</button>
                        </div>
                        <% } %>
                        
                        <% if (car.status !== 'Sold' && car.reservation_status !== 'Reserved') { %>
                        <button class="cro-reserve-btn" type="button" data-reserve-button onclick="handleReservation()">
                            🔒 Request to Lock In This Deal
                            <span class="cro-reserve-sub">₹9,999 refundable deposit · collected only after confirmation</span>
                        </button>
                        <% } else if (car.reservation_status === 'Reserved') { %>
                        <p class="cro-reservation-state" role="status" style="margin-top: 0;">This vehicle is currently reserved.</p>
                        <% } %>
                    </div>

                    <!-- Bottom section: Actions -->
                    <div style="display: flex; flex-direction: column; gap: 12px; padding-top: 16px; border-top: 1px solid var(--detail-line);">
                        <p class="sidebar-reference" style="padding: 0; margin: 0; border: none; text-align: center;">Quote reference <strong><%= referenceLabel %></strong> when you call.</p>
                        
                        <div class="sidebar-actions">
                            <a class="button button-drive" href="#test-drive-form"><span aria-hidden="true">↗</span> Book a test drive</a>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 9px;">
                                <a class="button button-minimal" href="<%= whatsappUrl %>" target="_blank" rel="noopener noreferrer" id="whatsapp-btn">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width: 18px; height: 18px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg> WhatsApp
                                </a>
                                <a class="button button-minimal" href="tel:+919516486666">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width: 18px; height: 18px;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg> Call us
                                </a>
                            </div>
                        </div>

                        <button class="shortlist-button" type="button" data-car-id="<%= car._id %>" data-full-label="true" onclick="toggleShortlist('<%= car._id %>', this)" aria-label="Save <%= vehicleName %> to shortlist" style="margin-top: 0;">
                            <svg class="save-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                            </svg>
                            <span class="save-text">Save to shortlist</span>
                        </button>
                    </div>

                    <!-- Trust and Info Section -->
                    <div style="display: flex; flex-direction: column; gap: 16px; padding-top: 20px; border-top: 1px solid var(--detail-line);">
                        <div class="cro-trust-strip" style="margin-top: 0; padding-top: 0; border-top: none; gap: 12px; align-items: start;">
                            <div class="cro-trust-item" style="flex-direction: column; text-align: center; gap: 8px; padding: 0;">
                                <span class="cro-trust-icon" style="color: var(--detail-ink); display: flex;">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width: 24px; height: 24px;"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
                                </span>
                                <span>150-Point<br>Inspection</span>
                            </div>
                            <div class="cro-trust-item" style="flex-direction: column; text-align: center; gap: 8px; padding: 0;">
                                <span class="cro-trust-icon" style="color: var(--detail-ink); display: flex;">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width: 24px; height: 24px;"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
                                </span>
                                <span>7-Day<br>Money-Back</span>
                            </div>
                            <div class="cro-trust-item" style="flex-direction: column; text-align: center; gap: 8px; padding: 0;">
                                <span class="cro-trust-icon" style="color: var(--detail-ink); display: flex;">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="width: 24px; height: 24px;"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                                </span>
                                <span>1-Year<br>Warranty</span>
                            </div>
                        </div>
                        <a class="cro-history-badge" href="#test-drive-form" onclick="requestVehicleHistory(event)" style="margin-top: 4px; justify-content: center;">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width: 16px; height: 16px; margin-right: 4px;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                            Request a Free Vehicle History Report
                        </a>
                        <p class="showroom-note" style="text-align: center; margin-top: 0;">The Auto Choice · Wright Town, Jabalpur</p>
                    </div>
                </div>
                <details class="finance-calc card-surface">
                    <summary>Plan a down payment</summary>
                    <div class="finance-calc-content">
                        <label for="calc-down">Down payment (₹)</label>
                        <input type="number" id="calc-down" value="<%= Math.min(200000, Math.round(currentPrice * 0.1)) %>" step="25000" min="0" max="<%= currentPrice %>" oninput="calculateEMI()">
                        <label for="calc-term">Loan tenure</label>
                        <select id="calc-term" onchange="calculateEMI()">
                            <option value="36">3 years</option>
                            <option value="48">4 years</option>
                            <option value="60" selected>5 years</option>
                            <option value="84">7 years</option>
                        </select>
                        <p class="finance-estimate"><strong id="calc-result">₹0</strong><span>Estimated monthly EMI</span></p>
                        <p class="finance-note">Estimate at 9% annual interest. Final terms depend on lender approval.</p>
                    </div>
                </details>
            </aside>
        </div>

        <section class="similar-cars-section" aria-labelledby="similar-cars-title">
            <div class="similar-cars-heading">
                <div>
                    <span class="section-eyebrow">More to explore</span>
                    <h2 id="similar-cars-title">Similar cars</h2>
                    <p>Other cars you may want to take a look at.</p>
                </div>
                <a class="similar-more-link" href="/inventory">View more cars <span aria-hidden="true">→</span></a>
            </div>

            <% if (similarCars && similarCars.length) { %>
                <div class="similar-cars-grid">
                    <% similarCars.forEach(similarCar => { %>
                        <%
                            const similarImage = similarCar.images && similarCar.images.length
                                ? (typeof similarCar.images[0] === 'string' ? similarCar.images[0] : similarCar.images[0].url)
                                : 'https://images.unsplash.com/photo-1503376780353-7e6692767b70?w=800&q=80';
                            const similarTitle = [similarCar.year, similarCar.make, similarCar.model].filter(Boolean).join(' ');
                        %>
                        <article class="similar-car-card">
                            <a class="similar-car-link" href="/inventory/<%= similarCar.slug || similarCar._id %>">
                                <div class="similar-car-image-wrap">
                                    <img src="<%= similarImage %>" alt="<%= similarTitle %>" loading="lazy">
                                    <% if (similarCar.bodyType) { %><span class="similar-car-type"><%= similarCar.bodyType %></span><% } %>
                                </div>
                                <div class="similar-car-copy">
                                    <span class="similar-car-make"><%= similarCar.make %></span>
                                    <h3><%= similarTitle %></h3>
                                    <% if (similarCar.variant) { %><p class="similar-car-variant"><%= similarCar.variant %></p><% } %>
                                    <p class="similar-car-specs"><%= Number(similarCar.mileage || 0).toLocaleString('en-IN') %> km <span>·</span> <%= similarCar.fuelType || 'Fuel details on request' %> <span>·</span> <%= similarCar.transmission || 'Transmission details on request' %></p>
                                    <strong class="similar-car-price"><%= formatPrice(similarCar.croPricing.current_price) %></strong>
                                </div>
                            </a>
                            <div class="similar-car-actions">
                                <a href="/inventory/<%= similarCar.slug || similarCar._id %>" class="similar-details-link">View details</a>
                                <button class="similar-save-button" type="button" data-car-id="<%= similarCar._id %>" onclick="toggleShortlist('<%= similarCar._id %>', this)" aria-label="Save <%= similarTitle %> to shortlist">
                                    <svg class="save-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                                    </svg>
                                    <span class="save-text">Save</span>
                                </button>
                            </div>
                        </article>
                    <% }) %>
                </div>
            <% } else { %>
                <p class="similar-cars-empty">There are no other available cars to show right now.</p>
            <% } %>
            <a class="similar-more-link similar-more-link-mobile" href="/inventory">View more cars <span aria-hidden="true">→</span></a>
        </section>
    </div>

    <nav class="mobile-vehicle-actions" aria-label="Quick actions">
        <div class="mobile-price"><strong>₹<%= lakhPrice %> Lakh</strong><span><%= car.year %> · <%= car.model %></span></div>
        <a href="tel:+919516486666" aria-label="Call The Auto Choice">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width: 20px; height: 20px;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            Call
        </a>
        <a href="<%= whatsappUrl %>" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="width: 20px; height: 20px;"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>
            WhatsApp
        </a>
    </nav>
</main>

<script>
    const CAR_PRICE = <%= currentPrice %>;
    function selectVehiclePhoto(button) {
        const thumbnails = Array.from(document.querySelectorAll('.gallery-thumbnails .thumbnail'));
        const index = thumbnails.indexOf(button);
        switchImage(button.dataset.fullSrc, button);
        const counter = document.querySelector('.gallery-count');
        if (counter && index >= 0) {
            counter.textContent = `${String(index + 1).padStart(2, '0')} / ${String(thumbnails.length).padStart(2, '0')}`;
        }
        const mainImage = document.getElementById('pdp-main-img');
        const title = document.querySelector('.vehicle-heading h1')?.textContent || '';
        if (mainImage && index >= 0) mainImage.alt = `${title} — photo ${index + 1} of ${thumbnails.length}`;
    }
    document.addEventListener('DOMContentLoaded', () => {
        calculateEMI();
        initShortlistButtons();
    });
</script>
