<%- include('partials/header', { pageTitle: car.year + ' ' + car.make + ' ' + car.model + ' | AutoVault India' }) %>

<main>
<div class="container pdp-layout" id="pdp-section">

    <!-- ═══════════════ LEFT: MEDIA + SPECS ════════════════ -->
    <div class="pdp-main">

        <!-- Image Gallery -->
        <div class="media-gallery" id="pdp-gallery">
            <img
                id="pdp-main-img"
                src="<%= car.primaryImage %>"
                alt="<%= car.year %> <%= car.make %> <%= car.model %>"
            >
            <% if (car.images && car.images.length > 1) { %>
            <div class="thumbnail-strip" id="thumbnail-strip">
                <% car.images.forEach((img, i) => { %>
                    <img
                        src="<%= img.url %>"
                        alt="<%= car.make %> <%= car.model %> view <%= i + 1 %>"
                        class="thumbnail <%= i === 0 ? 'active' : '' %>"
                        id="thumb-<%= i %>"
                        onclick="switchImage('<%= img.url %>', this)"
                        loading="lazy"
                    >
                <% }) %>
            </div>
            <% } %>
        </div>

        <!-- Tabs -->
        <div class="pdp-tabs" id="pdp-tabs">
            <button class="tab active" onclick="switchTab(this, 'overview-panel')" id="tab-overview">Vehicle Overview</button>
            <button class="tab" onclick="switchTab(this, 'inspection-panel')" id="tab-inspection">200-Point Inspection Report</button>
        </div>

        <!-- Overview Panel -->
        <div id="overview-panel" class="tab-panel active">
            <div class="pdp-specs-grid" id="pdp-specs">
                <div class="spec-item"><span>Kilometers Run</span><%= car.mileage.toLocaleString('en-IN') %> km</div>
                <div class="spec-item"><span>Fuel Type</span><%= car.fuelType %></div>
                <div class="spec-item"><span>Transmission</span><%= car.transmission %></div>
                <div class="spec-item"><span>Seats</span><%= car.seats %></div>
                <% if (car.bodyType) { %><div class="spec-item"><span>Body Style</span><%= car.bodyType %></div><% } %>
                <% if (car.ownership) { %><div class="spec-item"><span>Ownership</span><%= car.ownership %></div><% } %>
                <% if (car.rto) { %><div class="spec-item"><span>RTO Registration</span><%= car.rto %></div><% } %>
                <% if (car.extColor) { %><div class="spec-item"><span>Exterior Color</span><%= car.extColor %></div><% } %>
                <% if (car.intColor) { %><div class="spec-item"><span>Interior Color</span><%= car.intColor %></div><% } %>
                <div class="spec-item"><span>Year of Manufacture</span><%= car.year %></div>
            </div>

            <% if (car.description) { %>
            <div class="pdp-description">
                <h3>About This Car</h3>
                <p><%= car.description %></p>
            </div>
            <% } %>
        </div>

        <!-- Inspection Panel -->
        <div id="inspection-panel" class="tab-panel" style="display:none;">
            <div class="inspection-grid">
                <% const checks = [
                    { area: 'Engine', status: 'Pass', icon: '✅' },
                    { area: 'Transmission & Gearbox', status: 'Pass', icon: '✅' },
                    { area: 'Suspension & Steering', status: 'Pass', icon: '✅' },
                    { area: 'Brakes (ABS/EBD)', status: 'Pass', icon: '✅' },
                    { area: 'Electricals & Battery', status: 'Pass', icon: '✅' },
                    { area: 'AC & Heating System', status: 'Pass', icon: '✅' },
                    { area: 'Body & Paint', status: 'Pass', icon: '✅' },
                    { area: 'Interior Condition', status: 'Pass', icon: '✅' },
                    { area: 'Tyres & Wheels', status: 'Pass', icon: '✅' },
                    { area: 'Odometer Integrity', status: 'Pass', icon: '✅' }
                ]; %>
                <% checks.forEach(check => { %>
                    <div class="inspection-item">
                        <span class="insp-icon"><%= check.icon %></span>
                        <div>
                            <strong><%= check.area %></strong>
                            <span class="insp-status pass"><%= check.status %></span>
                        </div>
                    </div>
                <% }) %>
            </div>
        </div>

    </div>

    <!-- ═══════════════ RIGHT: SIDEBAR ════════════════ -->
    <aside class="pdp-sidebar" id="pdp-sidebar">

        <!-- Title & Price -->
        <div class="pdp-title-block">
            <h1 id="pdp-title"><%= car.year %> <%= car.make %> <%= car.model %></h1>
            <div class="pdp-price" id="pdp-price"><%= car.formattedPrice %></div>
            <p class="cpo-tag" id="pdp-cpo">✓ AutoVault Certified</p>
        </div>

        <!-- WhatsApp CTA -->
        <%
            const waNumber = '919999999999'; // ← Replace with your WhatsApp Business number
            const waText = encodeURIComponent(
                'Hi, I am interested in the ' + car.year + ' ' + car.make + ' ' + car.model +
                ' listed for ₹' + car.price.toLocaleString('en-IN') + '. Please share more details.'
            );
            const waLink = 'https://wa.me/' + waNumber + '?text=' + waText;
        %>
        <a href="<%= waLink %>" target="_blank" rel="noopener noreferrer" class="btn-whatsapp" id="whatsapp-btn">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Chat on WhatsApp
        </a>

        <!-- Test Drive Lead Form -->
        <div class="lead-form" id="test-drive-form">
            <h3>Book Free Home Test Drive</h3>
            <form onsubmit="handleTestDrive(event)" id="test-drive-submit-form">
                <input type="text"   id="td-name"  placeholder="Your Full Name"        required>
                <input type="tel"    id="td-phone" placeholder="Mobile Number (+91)"   required>
                <input type="text"   id="td-city"  placeholder="City / Pincode"        required>
                <button type="submit" class="btn-primary w-100" id="schedule-btn">Schedule Test Drive</button>
            </form>
        </div>

        <!-- EMI Calculator -->
        <div class="finance-calc" id="emi-calc">
            <h3>EMI Loan Calculator</h3>
            <div class="filter-group">
                <label for="calc-down">Down Payment (₹)</label>
                <input type="number" id="calc-down" value="200000" step="25000" min="0"
                    max="<%= car.price %>" oninput="calculateEMI()">
            </div>
            <div class="filter-group">
                <label for="calc-term">Loan Tenure</label>
                <select id="calc-term" onchange="calculateEMI()">
                    <option value="36">3 Years (36 Months)</option>
                    <option value="48">4 Years (48 Months)</option>
                    <option value="60" selected>5 Years (60 Months)</option>
                    <option value="84">7 Years (84 Months)</option>
                </select>
            </div>
            <div class="est-payment">
                <span id="calc-result">₹0</span> / month
            </div>
            <p class="calc-subtext">Estimated at standard 9.0% interest p.a.</p>
        </div>

        <!-- Shortlist Button -->
        <button
            class="btn-save w-100"
            id="save-btn-<%= car._id %>"
            data-car-id="<%= car._id %>"
            onclick="toggleShortlist('<%= car._id %>', this)"
        >
            🤍 Save to Shortlist
        </button>

        <!-- Admin Delete (simple, no auth guard in this demo) -->
        <details class="admin-actions">
            <summary>Admin Actions</summary>
            <form action="/admin/delete/<%= car._id %>" method="POST"
                onsubmit="return confirm('Delete this car permanently?')">
                <button type="submit" class="btn-delete w-100" id="delete-btn-<%= car._id %>">🗑 Delete Listing</button>
            </form>
        </details>

    </aside>
</div>

<!-- Back Link -->
<div class="container" style="margin-top:2rem; margin-bottom:3rem;">
    <a href="/inventory" class="btn-text" id="back-to-inventory">← Back to Inventory</a>
</div>

</main>

<!-- Pass car price to JS for EMI calculator -->
<script>
    const CAR_PRICE = <%= car.price %>;
    document.addEventListener('DOMContentLoaded', () => {
        calculateEMI();
        initShortlistButtons();
    });
</script>

<%- include('partials/footer') %>
