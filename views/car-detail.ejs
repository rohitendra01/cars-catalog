<!DOCTYPE html>
<html lang="en">
<% const vehicleName=[car.year, car.make, car.model, car.variant].filter(Boolean).join(' ');
    const rawMileage = car.mileage !== undefined && car.mileage !== null ? car.mileage : car.odometer;
    const hasMileage = rawMileage !== undefined && rawMileage !== null && String(rawMileage).trim() !== '' && Number.isFinite(Number(rawMileage));
    const mileageLabel = hasMileage ? Number(rawMileage).toLocaleString('en-IN') : '' ; const
    referenceLabel=car.referenceId || (car._id ? `AC${String(car._id).slice(-8).toUpperCase()}` : '—' ); const
    registrationLabel=car.registrationState || car.rtoLocation || car.rto || '' ; const galleryImages=(car.images ||
    []).map(image=> typeof image === 'string' ? image : image.url).filter(Boolean);
    const listedPrice = Number(car.price);
    const hasPrice = Number.isFinite(listedPrice) && listedPrice > 0;
    const croPrice = Number(car.croPricing && car.croPricing.current_price);
    const currentPrice = hasPrice ? (Number.isFinite(croPrice) && croPrice > 0 ? croPrice : listedPrice) : 0;
    const savingsAmount = hasPrice ? Number(car.croPricing && car.croPricing.savings_amount || 0) : 0;
    const anchorPrice = hasPrice ? Number(car.croPricing && car.croPricing.anchor_price || car.market_value ||
    listedPrice) : 0;
    const anchorLabel = car.croPricing && car.croPricing.anchor_label || 'Market Value';
    const lakhPrice = hasPrice ? (currentPrice / 100000).toFixed(2) : '';
    const rupeePrice = hasPrice ? currentPrice.toLocaleString('en-IN') : '';
    const manufactureDate = car.manufacturedDate && !Number.isNaN(new Date(car.manufacturedDate).getTime())
    ? new Intl.DateTimeFormat('en-IN', { month: 'long', year: 'numeric' }).format(new Date(car.manufacturedDate))
    : '';
    const vehicleDescription = String(car.description || '').trim();
    const vehicleSublineItems = [['Odometer', hasMileage ? mileageLabel + ' km' : ''], ['Fuel', car.fuelType],
    ['Transmission', car.transmission], ['Seats', car.seats ? car.seats + ' seats' : ''], ['Ownership',
    car.ownership]].filter(([, v]) => v !== undefined && v !== null && String(v).trim() !== '');
    const quickItems = [['Odometer', hasMileage ? mileageLabel + ' km' : ''], ['Year', car.year], ['Fuel',
    car.fuelType], ['Gearbox', car.transmission], ['Seats', car.seats], ['Owner', car.ownership]].filter(([, v]) => v
    !== undefined && v !== null && String(v).trim() !== '');
    const legacyFeatureNames = { sunroof: 'Sunroof', alloyWheels: 'Alloy wheels', touchscreen: 'Touchscreen',
    reverseCamera: 'Rear parking camera' };
    const safeJson = value => JSON.stringify(value).replace(/</g, '\\u003c' ); const equipmentItems=Array.from(new Map([
        ...(Array.isArray(car.equipment) ? car.equipment : []), ...Object.entries(car.features || {}).filter(([key,
        enabled])=> enabled && legacyFeatureNames[key]).map(([key]) => legacyFeatureNames[key])
    ].map(item => String(item || '').trim()).filter(Boolean).map(item => [item.toLowerCase(), item])).values());
    const highlightItems = [
    car.ownership || '',
    car.seats ? `${car.seats} seats` : '',
    car.insuranceType ? `${car.insuranceType} insurance` : '',
    car.engine || '',
    ...equipmentItems.slice(0, 2)
    ].filter(Boolean).slice(0, 4);
    const specificationItems = [
    ['Make', car.make],
    ['Model', car.model],
    ['Variant', car.variant],
    ['Model year', car.year],
    ['Manufactured', manufactureDate],
    ['Odometer', hasMileage ? `${mileageLabel} km` : ''],
    ['Fuel', car.fuelType],
    ['Transmission', car.transmission],
    ['Engine', car.engine],
    ['Body type', car.bodyType],
    ['Seats', car.seats],
    ['Colour', car.extColor],
    ['Interior colour', car.intColor],
    ['Ownership', car.ownership],
    ['Registration', registrationLabel],
    ['Insurance', car.insuranceType],
    ['Photographs', galleryImages.length || ''],
    ['Reference', referenceLabel]
    ].filter(([, value]) => value !== undefined && value !== null && String(value).trim() !== '');
    const whatsappMessage = encodeURIComponent('Hi The Auto Choice, I’m interested in the ' + vehicleName + (hasPrice ?
    ' listed for ₹' + rupeePrice : '') + ' (ref ' + referenceLabel + '). Could you please share more details? ' +
    (typeof absoluteCarUrl !== 'undefined' ? absoluteCarUrl : ''));
    const whatsappUrl = 'https://wa.me/919516486666?text=' + whatsappMessage;
    const structuredData = {
    '@context': 'https://schema.org',
    '@type': 'Car',
    name: vehicleName,
    image: galleryImages.length ? galleryImages : undefined,
    description: car.description || `${vehicleName} listed by The Auto Choice. Contact the showroom to confirm current
    availability and arrange a viewing.`,
    brand: { '@type': 'Brand', name: car.make },
    model: car.model,
    vehicleModelDate: String(car.year),
    mileageFromOdometer: hasMileage ? { '@type': 'QuantitativeValue', value: Number(rawMileage), unitCode: 'KMT' } :
    undefined,
    fuelType: car.fuelType,
    vehicleTransmission: car.transmission,
    offers: hasPrice ? {
    '@type': 'Offer',
    price: currentPrice,
    priceCurrency: 'INR',
    availability: car.status === 'Sold' || car.reservation_status === 'Reserved' ? 'https://schema.org/SoldOut' :
    'https://schema.org/InStock',
    url: typeof absoluteCarUrl !== 'undefined' ? absoluteCarUrl : `/inventory/${car.slug || car._id}`,
    seller: {
    '@type': 'AutoDealer',
    name: 'The Auto Choice',
    address: {
    '@type': 'PostalAddress',
    streetAddress: 'Plot no. 43 Infront of Flyover Over Pillar no. 123, Madan Mahal Station Road, Ranital Chowk',
    addressLocality: 'Jabalpur',
    addressRegion: 'M.P.',
    postalCode: '482001',
    addressCountry: 'IN'
    }
    }
    } : undefined
    };
    %>
    <%- include('partials/head-public', { pageTitle: `${vehicleName} | The Auto Choice`, metaDescription: `Explore this
        ${vehicleName}: ${mileageLabel} km, ${car.fuelType || 'fuel details on request' }, ${car.transmission
        || 'transmission details on request' }. View photos, specifications and equipment.`, canonicalUrl: typeof
        absoluteCarUrl !=='undefined' ? absoluteCarUrl : `/inventory/${car.slug || car._id}`, ogImage: galleryImages[0]
        || car.primaryImage, pageStylesheet: '/css/car-detail.css' }) %>

        <body data-vehicle-id="<%= car._id %>">
            <%- include('partials/navbar', { isAdmin: typeof isAdmin !=='undefined' && isAdmin }) %>

                <main class="vehicle-detail-page" id="main">
                    <div class="container vehicle-detail-container">
                        <nav class="vehicle-breadcrumbs" aria-label="Breadcrumb">
                            <ol>
                                <li><a href="/">Home</a></li>
                                <li aria-hidden="true">/</li>
                                <li><a href="/inventory">Cars for sale</a></li>
                                <% if (car.bodyType) { %>
                                    <li aria-hidden="true">/</li>
                                    <li><a href="/inventory?bodyType=<%= encodeURIComponent(car.bodyType) %>">
                                            <%= car.bodyType %>s
                                        </a></li>
                                    <% } %>
                                        <li aria-hidden="true">/</li>
                                        <li aria-current="page">
                                            <%= car.make %>
                                                <%= car.model %>
                                        </li>
                            </ol>
                        </nav>

                        <header class="vehicle-heading">
                            <div class="vehicle-heading-copy">
                                <div class="vehicle-kicker-row">
                                    <span class="vehicle-make">
                                        <%= car.make %>
                                    </span>
                                    <span class="vehicle-year">
                                        <%= car.year %>
                                    </span>
                                    <span class="vehicle-reference">Ref <strong>
                                            <%= referenceLabel %>
                                        </strong></span>
                                </div>
                                <h1>
                                    <%= vehicleName %>
                                </h1>
                                <% if (vehicleSublineItems.length) { %>
                                    <p class="vehicle-subline">
                                        <% vehicleSublineItems.forEach(([, value])=> { %><span>
                                                <%= value %>
                                            </span>
                                            <% }) %>
                                    </p>
                                    <% } %>
                            </div>
                            <% if (hasPrice) { %>
                                <div class="vehicle-heading-price" aria-label="Vehicle price">
                                    <% if (savingsAmount> 0) { %>
                                        <span class="cro-market-price-label">
                                            <%= anchorLabel %>
                                        </span>
                                        <span class="cro-market-price">₹<%= (anchorPrice / 100000).toFixed(2) %>
                                                Lakh</span>
                                        <span class="cro-today-label">Today's Exclusive Price</span>
                                        <% } else { %>
                                            <span class="price-caption">Asking price</span>
                                            <% } %>
                                                <strong>₹<%= lakhPrice %> <small>Lakh</small></strong>
                                                <span class="exact-price">₹<%= rupeePrice %></span>
                                                <% if (savingsAmount> 0) { %>
                                                    <div class="cro-savings-badge">↓ ₹<%=
                                                            savingsAmount.toLocaleString('en-IN') %> Below Market Value
                                                    </div>
                                                    <% } %>
                                                        <% if (car.discount_tag) { %>
                                                            <div class="cro-deal-badge" style="margin-top: 6px;">
                                                                <% if (car.discount_tag &&
                                                                    !isNaN(Number(car.discount_tag))) { %>
                                                                    ↓ ₹<%=
                                                                        Number(car.discount_tag).toLocaleString('en-IN')
                                                                        %> Discount
                                                                        <% } else { %>
                                                                            <%= car.discount_tag || 'Featured Deal' %>
                                                                                <% } %>
                                                            </div>
                                                            <% } %>
                                </div>
                                <% } %>
                        </header>

                        <div class="vehicle-page-grid <%= galleryImages.length ? 'has-gallery' : 'no-gallery' %>">
                                <div class="vehicle-main-column">
                                    <% if (galleryImages.length) { %>
                                    <section class="vehicle-gallery card-surface" aria-label="Vehicle photographs">
                                        <div class="gallery-stage">
                                            <img id="pdp-main-img" class="gallery-main-image"
                                                src="<%= galleryImages[0] %>"
                                                alt="<%= vehicleName %> — photo 1 of <%= galleryImages.length %>"
                                                fetchpriority="high">
                                            <span class="gallery-count">
                                                <%= String(1).padStart(2, '0' ) %> / <%=
                                                        String(galleryImages.length).padStart(2, '0' ) %>
                                            </span>
                                        </div>
                                        <% if (galleryImages.length> 1) { %>
                                            <div class="gallery-thumbnails" aria-label="Choose a vehicle photo">
                                                <% galleryImages.forEach((imageUrl, index)=> { %><button type="button"
                                                        class="thumbnail <%= index === 0 ? 'active' : '' %>"
                                                        onclick="selectVehiclePhoto(this)"
                                                        data-full-src="<%= imageUrl %>"
                                                        aria-label="Show photo <%= index + 1 %> of <%= galleryImages.length %>"><img
                                                            src="<%= imageUrl %>" alt="" loading="lazy"></button>
                                                    <% }) %>
                                            </div>
                                            <% } %>
                                    </section>
                                    <% } else { %>
                                    <section class="vehicle-gallery gallery-empty card-surface" aria-label="Vehicle photographs">
                                        <svg class="gallery-empty-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <rect x="5" y="8" width="38" height="32" rx="5" />
                                            <circle cx="18" cy="21" r="4" />
                                            <path d="m8 36 11-11 7 7 5-5 9 9" />
                                        </svg>
                                        <strong>Photos are coming soon</strong>
                                        <span>Contact our showroom to arrange a viewing.</span>
                                    </section>
                                    <% } %>
                                </div>
                                    <aside class="vehicle-sidebar"
                                        aria-label="<%= hasPrice ? 'Price and enquiry' : 'Enquiry and test drive' %>">
                                        <div
                                            class="vehicle-action-card card-surface <%= hasPrice ? 'has-price' : 'no-price' %>">
                                            <% const emiAmount=Number(car.croPricing && car.croPricing.monthly_estimate
                                                || 0); const isSold=car.status==='Sold' ; const
                                                isReserved=car.reservation_status==='Reserved' ; const
                                                canContact=!isSold && !isReserved; const canReserve=hasPrice &&
                                                canContact; const hasDealInfo=(hasPrice && emiAmount> 0) || canReserve
                                                || isReserved;
                                                %>
                                                <% if (hasPrice || isSold || isReserved) { %>
                                                    <div class="sidebar-vehicle-summary">
                                                        <div
                                                            class="sidebar-status <%= isSold ? 'is-sold' : isReserved ? 'is-reserved' : '' %>">
                                                            <span></span>
                                                            <%= isSold ? 'Recently sold' : isReserved
                                                                ? 'Currently reserved' : 'Enquire about this car' %>
                                                        </div>
                                                        <% if (hasPrice) { %>
                                                            <div class="sidebar-price">
                                                                <% if (savingsAmount> 0) { %><span
                                                                        class="cro-market-price-label">
                                                                        <%= anchorLabel %>
                                                                    </span><span class="cro-market-price">₹<%=
                                                                            anchorPrice.toLocaleString('en-IN') %>
                                                                            </span><span class="cro-today-label">Today's
                                                                        Exclusive Price</span>
                                                                    <% } else { %><span>Price</span>
                                                                        <% } %>
                                                                            <strong>₹<%= lakhPrice %>
                                                                                    <small>Lakh</small></strong><span
                                                                                class="exact-price">₹<%= rupeePrice %>
                                                                                    </span>
                                                                            <% if (savingsAmount> 0 || car.discount_tag)
                                                                                { %>
                                                                                <div class="sidebar-deal-badges">
                                                                                    <% if (savingsAmount> 0) { %><div
                                                                                            class="cro-savings-badge">↓
                                                                                            ₹<%= savingsAmount.toLocaleString('en-IN')
                                                                                                %> Below Market</div>
                                                                                        <% } %>
                                                                                            <% if (car.discount_tag) {
                                                                                                %>
                                                                                                <div
                                                                                                    class="cro-deal-badge">
                                                                                                    <% if
                                                                                                        (!isNaN(Number(car.discount_tag)))
                                                                                                        { %>↓ ₹<%=
                                                                                                            Number(car.discount_tag).toLocaleString('en-IN')
                                                                                                            %> Discount
                                                                                                            <% } else {
                                                                                                                %>
                                                                                                                <%= car.discount_tag
                                                                                                                    %>
                                                                                                                    <% }
                                                                                                                        %>
                                                                                                </div>
                                                                                                <% } %>
                                                                                </div>
                                                                                <% } %>
                                                            </div>
                                                            <% } %>
                                                    </div>
                                                    <% } %>

                                                        <% if (hasDealInfo) { %>
                                                            <div class="vehicle-deal-info">
                                                                <% if (hasPrice && emiAmount> 0) { %><div
                                                                        class="cro-emi-teaser">As low as <strong>₹<%=
                                                                                emiAmount.toLocaleString('en-IN') %>
                                                                                /mo</strong> with zero down<button
                                                                            class="cro-calc-link" type="button"
                                                                            onclick="document.querySelector('.finance-calc')?.scrollIntoView({behavior:'smooth'});document.querySelector('.finance-calc')?.setAttribute('open','')">Calculate
                                                                            Financing →</button></div>
                                                                    <% } %>
                                                                        <% if (canReserve) { %><button
                                                                                class="cro-reserve-btn" type="button"
                                                                                data-reserve-button
                                                                                onclick="handleReservation()">🔒 Request
                                                                                to Lock In This Deal<span
                                                                                    class="cro-reserve-sub">₹9,999
                                                                                    refundable deposit · collected only
                                                                                    after confirmation</span></button>
                                                                            <% } else if (isReserved) { %>
                                                                                <p class="cro-reservation-state"
                                                                                    role="status">This vehicle is
                                                                                    currently reserved.</p>
                                                                                <% } %>
                                                            </div>
                                                            <% } %>

                                                                <div
                                                                    class="vehicle-contact-actions <%= hasPrice ? 'has-price' : 'no-price' %>">
                                                                    <% if (hasPrice && referenceLabel) { %>
                                                                        <p class="sidebar-reference">Quote reference
                                                                            <strong>
                                                                                <%= referenceLabel %>
                                                                            </strong> when you call.</p>
                                                                        <% } %>
                                                                            <% if (canContact) { %><a
                                                                                    class="button button-test-drive sidebar-test-drive"
                                                                                    href="#enquiry-form"
                                                                                    onclick="requestTestDrive(event)"><svg
                                                                                        viewBox="0 0 24 24" fill="none"
                                                                                        stroke="currentColor"
                                                                                        stroke-width="1.9"
                                                                                        stroke-linecap="round"
                                                                                        stroke-linejoin="round"
                                                                                        aria-hidden="true">
                                                                                        <rect x="3" y="4" width="18"
                                                                                            height="17" rx="2" />
                                                                                        <path
                                                                                            d="M16 2v4M8 2v4M3 10h18M8 14h3M8 17h6" />
                                                                                    </svg>Book a Test Drive</a>
                                                                                <% } %>
                                                                                    <div class="sidebar-actions">
                                                                                        <a class="button button-drive"
                                                                                            href="#enquiry-form">Send
                                                                                            Enquiry</a>
                                                                                        <div
                                                                                            class="sidebar-contact-links">
                                                                                            <a class="button button-minimal"
                                                                                                href="#enquiry-form"
                                                                                                id="whatsapp-btn"
                                                                                                onclick="mobileWhatsAppClick(event)">WhatsApp</a><%-
                                                                                                include('partials/call-picker',
                                                                                                {
                                                                                                variant: 'is-car-sidebar'
                                                                                                , callLabel: 'Call us' ,
                                                                                                buttonClass: 'button button-minimal'
                                                                                                }) %></div>
                                                                                    </div>
                                                                                    <button class="shortlist-button"
                                                                                        type="button"
                                                                                        data-car-id="<%= car._id %>"
                                                                                        data-full-label="true"
                                                                                        onclick="toggleShortlist('<%= car._id %>', this)"
                                                                                        aria-label="Save <%= vehicleName %> to shortlist"
                                                                                        style="margin-top: 0;"><svg
                                                                                            class="save-icon"
                                                                                            viewBox="0 0 24 24"
                                                                                            fill="none"
                                                                                            stroke="currentColor"
                                                                                            stroke-width="2"
                                                                                            stroke-linecap="round"
                                                                                            stroke-linejoin="round"
                                                                                            aria-hidden="true">
                                                                                            <path
                                                                                                d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
                                                                                        </svg><span
                                                                                            class="save-text">Save to
                                                                                            shortlist</span></button>
                                                                </div>
                                        </div>
                                        <% if (hasPrice) { %>
                                            <details class="finance-calc card-surface">
                                                <summary>Plan a down payment</summary>
                                                <div class="finance-calc-content">
                                                    <label for="calc-down">Down payment (₹)</label>
                                                    <input type="number" id="calc-down"
                                                        value="<%= Math.min(200000, Math.round(currentPrice * 0.1)) %>"
                                                        step="25000" min="0" max="<%= currentPrice %>"
                                                        oninput="calculateEMI()">
                                                    <label for="calc-term">Loan tenure</label>
                                                    <select id="calc-term" onchange="calculateEMI()">
                                                        <option value="36">3 years</option>
                                                        <option value="48">4 years</option>
                                                        <option value="60" selected>5 years</option>
                                                        <option value="84">7 years</option>
                                                    </select>
                                                    <p class="finance-estimate"><strong
                                                            id="calc-result">₹0</strong><span>Estimated monthly
                                                            EMI</span></p>
                                                </div>
                                            </details>
                                            <% } %>
                                    </aside>
                                    <div class="vehicle-detail-content">
                                        <% if (quickItems.length) { %>
                                            <section class="quick-overview card-surface"
                                                aria-label="Key vehicle details">
                                                <% quickItems.forEach(([label, value])=> { %><div class="quick-item">
                                                        <span class="quick-label">
                                                            <%= label %>
                                                        </span><strong>
                                                            <%= value %>
                                                        </strong></div>
                                                    <% }) %>
                                            </section>
                                            <% } %>

                                                <% if (vehicleDescription || highlightItems.length) { %>
                                                    <section
                                                        class="detail-section vehicle-overview-section card-surface"
                                                        aria-labelledby="about-title">
                                                        <div class="section-heading"><span
                                                                class="section-eyebrow">Vehicle overview</span>
                                                            <h2 id="about-title">About this car</h2>
                                                        </div>
                                                        <% if (vehicleDescription) { %>
                                                            <p class="vehicle-description">
                                                                <%= vehicleDescription %>
                                                            </p>
                                                            <% } %>
                                                                <% if (highlightItems.length) { %>
                                                                    <ul class="highlight-list"
                                                                        aria-label="Vehicle highlights">
                                                                        <% highlightItems.forEach(item=> { %><li><span
                                                                                    class="highlight-check"
                                                                                    aria-hidden="true">✓</span>
                                                                                <%= item %>
                                                                            </li>
                                                                            <% }) %>
                                                                    </ul>
                                                                    <% } %>
                                                    </section>
                                                    <% } %>

                                                        <% if (specificationItems.length) { %>
                                                            <details
                                                                class="detail-disclosure specifications-section card-surface">
                                                                <summary aria-controls="vehicle-specifications">
                                                                    <span class="disclosure-heading">
                                                                        <span class="section-eyebrow">Full vehicle
                                                                            details</span>
                                                                        <span class="disclosure-title"
                                                                            id="specifications-title">Specifications</span>
                                                                    </span>
                                                                    <span class="disclosure-meta">
                                                                        <%= specificationItems.length %> details
                                                                    </span>
                                                                    <span class="disclosure-chevron"
                                                                        aria-hidden="true"></span>
                                                                </summary>
                                                                <div class="disclosure-content"
                                                                    id="vehicle-specifications">
                                                                    <dl class="specification-grid">
                                                                        <% specificationItems.forEach(([label, value])=>
                                                                            { %>
                                                                            <div class="specification-item">
                                                                                <dt>
                                                                                    <%= label %>
                                                                                </dt>
                                                                                <dd>
                                                                                    <%= value %>
                                                                                        <%= label==='Photographs'
                                                                                            ? ' photos' : '' %>
                                                                                </dd>
                                                                            </div>
                                                                            <% }) %>
                                                                    </dl>
                                                                    <p class="specification-note">Details are provided
                                                                        as listed by The Auto Choice. Please confirm
                                                                        anything important when you see the car.</p>
                                                                </div>
                                                            </details>
                                                            <% } %>

                                                                <% if (equipmentItems.length) { %>
                                                                    <details
                                                                        class="detail-disclosure equipment-section card-surface">
                                                                        <summary aria-controls="vehicle-equipment"><span
                                                                                class="disclosure-heading"><span
                                                                                    class="section-eyebrow">Included
                                                                                    with this vehicle</span><span
                                                                                    class="disclosure-title"
                                                                                    id="equipment-title">Equipment</span></span><span
                                                                                class="disclosure-meta">
                                                                                <%= equipmentItems.length %> features
                                                                            </span><span class="disclosure-chevron"
                                                                                aria-hidden="true"></span></summary>
                                                                        <div class="disclosure-content"
                                                                            id="vehicle-equipment">
                                                                            <ul class="equipment-grid">
                                                                                <% equipmentItems.forEach(item=> { %>
                                                                                    <li><span class="equipment-check"
                                                                                            aria-hidden="true">✓</span>
                                                                                        <%= item %>
                                                                                    </li>
                                                                                    <% }) %>
                                                                            </ul>
                                                                        </div>
                                                                    </details>
                                                                    <% } %>

                                                                        <section
                                                                            class="detail-section enquiry-section card-surface"
                                                                            id="enquiry-form"
                                                                            aria-labelledby="enquiry-title">
                                                                            <div class="section-heading">
                                                                                <span class="section-eyebrow">Get in
                                                                                    touch instantly</span>
                                                                                <h2 id="enquiry-title">Send Enquiry</h2>
                                                                            </div>
                                                                            <p class="enquiry-intro">Share any details
                                                                                you like and we'll open WhatsApp with a
                                                                                ready-to-send message. All contact and
                                                                                message fields are optional.</p>
                                                                            <form class="enquiry-form"
                                                                                id="whatsapp-enquiry-form"
                                                                                onsubmit="handleEnquiry(event)"
                                                                                novalidate>
                                                                                <div
                                                                                    class="enquiry-form-grid enquiry-primary-fields">
                                                                                    <div class="form-group">
                                                                                        <label for="enq-name">Your Name
                                                                                            <span
                                                                                                class="field-optional">(optional)</span></label>
                                                                                        <input type="text" id="enq-name"
                                                                                            name="name"
                                                                                            placeholder="Full name"
                                                                                            autocomplete="name">
                                                                                    </div>
