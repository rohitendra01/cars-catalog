<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin System | Panda Metals</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                        display: ['Helvetica Neue', 'Helvetica', 'Arial', 'sans-serif'],
                    },
                },
            },
        };
    </script>
    <script>
        (function () {
            var s = localStorage.getItem('cv-theme');
            var q = window.matchMedia('(prefers-color-scheme: dark)');
            if (s === 'dark' || (!s && q.matches)) {
                document.documentElement.classList.add('dark');
            }
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        /* Structural Scrollbar */
        ::-webkit-scrollbar {
            width: 10px;
            height: 10px;
        }

        ::-webkit-scrollbar-track {
            background: #f4f4f5;
            border-left: 1px solid #e4e4e7;
        }

        ::-webkit-scrollbar-thumb {
            background: #09090b;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #ea580c;
        }

        .dark ::-webkit-scrollbar-track {
            background: #09090b;
            border-left: 1px solid #27272a;
        }

        .dark ::-webkit-scrollbar-thumb {
            background: #fafafa;
        }

        .dark ::-webkit-scrollbar-thumb:hover {
            background: #ea580c;
        }

        /* Slide panel animation */
        .slide-panel {
            transform: translateX(100%);
            transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .slide-panel.open {
            transform: translateX(0);
        }

        .overlay {
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
        }

        .overlay.active {
            opacity: 1;
            pointer-events: all;
        }

        /* Toast Animation */
        .toast {
            animation: slideIn 0.3s ease, fadeOut 0.3s ease 2.7s;
        }

        @keyframes slideIn {
            from {
                transform: translateX(100%);
                opacity: 0;
            }

            to {
                transform: translateX(0);
                opacity: 1;
            }
        }

        @keyframes fadeOut {
            from {
                opacity: 1;
            }

            to {
                opacity: 0;
            }
        }
    </style>
</head>

<body class="bg-zinc-50 dark:bg-[#050505] text-zinc-950 dark:text-zinc-100 font-sans antialiased min-h-screen">

    <!-- Top Bar -->
    <header
        class="fixed top-0 w-full z-40 bg-white dark:bg-[#0a0a0a] border-b border-zinc-200 dark:border-zinc-800 h-16">
        <div class="flex items-center justify-between px-6 h-full max-w-[1920px] mx-auto">
            <div class="flex items-center gap-4">
                <a href="/" class="flex items-center gap-3 group">
                    <div
                        class="w-8 h-8 bg-zinc-950 dark:bg-white flex items-center justify-center group-hover:bg-orange-600 transition-colors">
                        <svg class="w-4 h-4 text-white dark:text-zinc-950" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
                        </svg>
                    </div>
                    <span
                        class="font-display font-black text-lg text-zinc-950 dark:text-white tracking-tighter uppercase hidden sm:block">Panda<span
                            class="text-orange-600">Metals</span></span>
                </a>
                <div class="w-px h-6 bg-zinc-200 dark:bg-zinc-800"></div>
                <h1 class="font-mono font-bold text-zinc-500 uppercase tracking-widest text-xs">System Control</h1>
            </div>
            <div class="flex items-center gap-4">
                <a href="/"
                    class="text-zinc-500 hover:text-orange-600 font-bold uppercase tracking-widest text-xs transition-colors hidden sm:block">Live
                    Site</a>

                <button id="dashThemeToggle"
                    class="p-2 text-zinc-500 hover:text-orange-600 transition-colors border border-transparent hover:border-zinc-200 dark:hover:border-zinc-800">
                    <svg id="dashIconMoon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
                    </svg>
                    <svg id="dashIconSun" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                </button>

                <a href="/logout"
                    class="px-4 py-2 bg-red-600 text-white font-bold uppercase tracking-widest text-[10px] hover:bg-red-700 transition-colors">Term
                    Session</a>
            </div>
        </div>
    </header>

    <!-- Main Dashboard -->
    <main class="pt-24 pb-12 max-w-[1920px] mx-auto">
        <div class="px-6 lg:px-12">

            <!-- Toolbar -->
            <div
                class="flex flex-col md:flex-row items-start md:items-end justify-between gap-6 mb-8 border-b border-zinc-200 dark:border-zinc-800 pb-6">
                <div>
                    <h2
                        class="font-display font-black text-4xl text-zinc-950 dark:text-white uppercase tracking-tighter mb-1">
                        Inventory.</h2>
                    <p class="text-zinc-500 font-mono text-xs uppercase tracking-widest" id="productCount">Awaiting
                        Sync...</p>
                </div>

                <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
                    <div class="relative w-full sm:w-72">
                        <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-400" fill="none"
                            stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                        <input type="text" id="searchInput" placeholder="SEARCH QUERY..."
                            class="w-full pl-11 pr-4 py-3 bg-white dark:bg-[#0a0a0a] border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white font-mono text-xs uppercase tracking-widest placeholder-zinc-400 focus:outline-none focus:border-orange-600 focus:ring-1 focus:ring-orange-600 rounded-none transition-colors" />
                    </div>
                    <button onclick="openPanel()"
                        class="w-full sm:w-auto px-6 py-3 bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 font-bold uppercase tracking-widest text-xs hover:bg-orange-600 dark:hover:bg-orange-500 transition-colors whitespace-nowrap">
                        + New Record
                    </button>
                </div>
            </div>

            <!-- Data Table -->
            <div class="bg-white dark:bg-[#0a0a0a] border border-zinc-200 dark:border-zinc-800">
                <div class="overflow-x-auto hide-scrollbar">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-zinc-100 dark:bg-zinc-900 border-b border-zinc-200 dark:border-zinc-800">
                                <th class="px-6 py-4 font-bold text-[10px] text-zinc-500 uppercase tracking-widest">
                                    Image</th>
                                <th class="px-6 py-4 font-bold text-[10px] text-zinc-500 uppercase tracking-widest">
                                    Serial No</th>
                                <th class="px-6 py-4 font-bold text-[10px] text-zinc-500 uppercase tracking-widest">Name
                                </th>
                                <th
                                    class="px-6 py-4 font-bold text-[10px] text-zinc-500 uppercase tracking-widest hidden md:table-cell">
                                    Category</th>
                                <th class="px-6 py-4 font-bold text-[10px] text-zinc-500 uppercase tracking-widest">
                                    Price</th>
                                <th
                                    class="px-6 py-4 font-bold text-[10px] text-zinc-500 uppercase tracking-widest hidden lg:table-cell">
                                    Status</th>
                                <th
                                    class="px-6 py-4 font-bold text-[10px] text-zinc-500 uppercase tracking-widest text-right">
                                    Commands</th>
                            </tr>
                        </thead>
                        <tbody id="productTableBody" class="divide-y divide-zinc-200 dark:divide-zinc-800">
                            <tr>
                                <td colspan="7"
                                    class="px-6 py-20 text-center text-zinc-500 font-mono text-sm uppercase tracking-widest border-b border-zinc-200 dark:border-zinc-800">
                                    Establishing Connection...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </main>

    <!-- Overlay -->
    <div id="overlay" class="overlay fixed inset-0 bg-zinc-950/80 backdrop-blur-sm z-50" onclick="closePanel()"></div>

    <!-- Slide-out Data Panel -->
    <div id="slidePanel"
        class="slide-panel fixed top-0 right-0 h-full w-full sm:w-[550px] bg-white dark:bg-[#0a0a0a] border-l border-zinc-200 dark:border-zinc-800 z-50 overflow-y-auto">
        <div class="p-8">
            <!-- Panel Header -->
            <div class="flex items-center justify-between mb-8 pb-4 border-b border-zinc-200 dark:border-zinc-800">
                <h3 id="panelTitle"
                    class="font-display font-black text-2xl text-zinc-950 dark:text-white uppercase tracking-tighter">
                    Initialize Product</h3>
                <button onclick="closePanel()"
                    class="p-2 border border-zinc-200 dark:border-zinc-800 text-zinc-500 hover:text-white hover:bg-zinc-950 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M6 18L18 6M6 6l12 12" />
                    </svg>
                </button>
            </div>

            <!-- Product Form -->
            <form id="productForm" enctype="multipart/form-data" class="space-y-6">
                <input type="hidden" id="productId" value="" />
                <input type="hidden" id="existingImages" value="[]" />

                <div>
                    <label
                        class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-2">Item
                        Name <span class="text-orange-600">*</span></label>
                    <input type="text" id="formName" required
                        class="w-full px-4 py-3 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-orange-600 focus:ring-1 focus:ring-orange-600 font-mono text-sm rounded-none"
                        placeholder="ENTER PRODUCT NAME" />
                </div>

                <div>
                    <label
                        class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-2">Serial
                        / SKU <span class="text-orange-600">*</span></label>
                    <input type="text" id="formSerialNo" required
                        class="w-full px-4 py-3 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-orange-600 focus:ring-1 focus:ring-orange-600 font-mono text-sm tracking-widest rounded-none"
                        placeholder="e.g. SN-001" />
                </div>

                <div class="grid grid-cols-2 gap-6">
                    <div>
                        <label
                            class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-2">Price
                            (INR)</label>
                        <input type="number" id="formPrice" min="0" step="0.01"
                            class="w-full px-4 py-3 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-orange-600 focus:ring-1 focus:ring-orange-600 font-mono text-sm rounded-none"
                            placeholder="0" />
                    </div>
                    <div class="relative" id="categoryWrapper">
                        <label
                            class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-2">Classification</label>
                        <div class="relative">
                            <input type="text" id="formCategory" autocomplete="off"
                                class="w-full px-4 py-3 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-orange-600 focus:ring-1 focus:ring-orange-600 font-mono text-sm pr-10 rounded-none"
                                placeholder="SELECT OR TYPE..." />
                            <button type="button" id="categoryDropdownBtn"
                                class="absolute inset-y-0 right-0 px-3 flex items-center text-zinc-500 hover:text-orange-600">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M19 9l-7 7-7-7" />
                                </svg>
                            </button>
                        </div>
                        <div id="categoryDropdown"
                            class="absolute z-50 w-full mt-1 bg-white dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 hidden flex-col max-h-60 overflow-hidden shadow-2xl">
                            <ul id="categoryList"
                                class="overflow-y-auto py-2 flex-1 font-mono text-xs uppercase tracking-widest">
                                <!-- Categories injected here via JS -->
                            </ul>
                            <div class="p-3 border-t border-zinc-200 dark:border-zinc-800 hidden bg-zinc-50 dark:bg-zinc-950"
                                id="categoryAddWrapper">
                                <button type="button" id="categoryAddBtn"
                                    class="w-full text-left px-2 py-2 text-xs font-bold text-orange-600 uppercase tracking-widest hover:bg-zinc-200 dark:hover:bg-zinc-800 transition-colors">
                                    + ADD "<span id="newCategoryName"></span>"
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div>
                    <label
                        class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-2">Description</label>
                    <textarea id="formDescription" rows="4"
                        class="w-full px-4 py-3 bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-950 dark:text-white placeholder-zinc-400 focus:outline-none focus:border-orange-600 focus:ring-1 focus:ring-orange-600 font-mono text-sm resize-none rounded-none"
                        placeholder="PROVIDE PRODUCT DETAILS..."></textarea>
                </div>

                <div>
                    <label
                        class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-2">Specifications
                        Database</label>
                    <div id="specsContainer" class="space-y-3 mb-3"></div>
                    <button type="button" onclick="addSpecRow('', '')"
                        class="w-full px-4 py-3 border border-dashed border-zinc-300 dark:border-zinc-700 hover:border-orange-600 text-zinc-500 hover:text-orange-600 transition-colors font-bold uppercase tracking-widest text-[10px] flex items-center justify-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                        </svg>
                        Append Specification Entry
                    </button>
                </div>

                <!-- Existing Images -->
                <div id="existingImagesPreview" class="hidden border-t border-zinc-200 dark:border-zinc-800 pt-6 mt-6">
                    <label
                        class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest mb-3">Active
                        Assets</label>
                    <div id="existingImagesGrid" class="grid grid-cols-4 gap-3"></div>
                </div>

                <!-- Upload Images -->
                <div class="border-t border-zinc-200 dark:border-zinc-800 pt-6 mt-6">
                    <div class="flex items-center justify-between mb-3">
                        <label
                            class="block text-[10px] font-bold text-zinc-950 dark:text-white uppercase tracking-widest">Asset
                            Upload</label>
                        <span id="imageCounter" class="text-zinc-500 font-mono text-[10px] uppercase tracking-widest">0
                            / 6 Max</span>
                    </div>
                    <div class="relative">
                        <input type="file" id="formImages" multiple accept="image/*" class="hidden"
                            onchange="handleImagePick(this)" />
                        <button type="button" onclick="document.getElementById('formImages').click()"
                            class="w-full px-4 py-8 border-2 border-dashed border-zinc-300 dark:border-zinc-700 hover:border-orange-600 hover:bg-orange-600/5 transition-colors text-center group">
                            <svg class="w-8 h-8 mx-auto mb-3 text-zinc-400 group-hover:text-orange-600 transition-colors"
                                fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                    d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            <span class="block text-zinc-500 font-mono text-[10px] uppercase tracking-widest">Click to
                                mount local files</span>
                        </button>
                    </div>
                    <div id="newImagesPreview" class="grid grid-cols-4 gap-3 mt-4"></div>
                </div>

                <!-- Flags -->
                <div class="border-t border-zinc-200 dark:border-zinc-800 pt-6 mt-6 space-y-4">
                    <div class="flex items-center gap-4">
                        <input type="checkbox" id="formPublished" checked
                            class="w-5 h-5 rounded-none bg-zinc-100 dark:bg-zinc-900 border-zinc-300 dark:border-zinc-700 text-orange-600 focus:ring-orange-600 focus:ring-offset-0 focus:ring-1" />
                        <label for="formPublished"
                            class="text-xs font-bold text-zinc-950 dark:text-white uppercase tracking-widest cursor-pointer">Live
                            / Published Status</label>
                    </div>
                    <div class="flex items-center gap-4">
                        <input type="checkbox" id="formFeatured"
                            class="w-5 h-5 rounded-none bg-zinc-100 dark:bg-zinc-900 border-zinc-300 dark:border-zinc-700 text-orange-600 focus:ring-orange-600 focus:ring-offset-0 focus:ring-1" />
                        <label for="formFeatured"
                            class="text-xs font-bold text-zinc-950 dark:text-white uppercase tracking-widest cursor-pointer">Promote
                            to Frontpage Flag</label>
                    </div>
                </div>

                <!-- Controls -->
                <div class="flex gap-4 pt-6 mt-6 border-t border-zinc-200 dark:border-zinc-800">
                    <button type="submit" id="submitBtn"
                        class="flex-1 py-4 bg-zinc-950 dark:bg-white text-white dark:text-zinc-950 font-bold uppercase tracking-widest text-[10px] hover:bg-orange-600 dark:hover:bg-orange-500 transition-colors">
                        Execute Save Sequence
                    </button>
                    <button type="button" onclick="closePanel()"
                        class="px-8 py-4 bg-zinc-100 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-zinc-600 dark:text-zinc-400 font-bold uppercase tracking-widest text-[10px] hover:bg-zinc-200 dark:hover:bg-zinc-800 transition-colors">
                        Abort
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Delete Modal -->
    <div id="deleteModal"
        class="fixed inset-0 z-[60] hidden items-center justify-center bg-zinc-950/90 backdrop-blur-sm">
        <div
            class="bg-white dark:bg-[#0a0a0a] border border-zinc-200 dark:border-zinc-800 p-8 max-w-sm w-full mx-4 shadow-2xl relative">
            <div class="absolute top-0 left-0 w-full h-1 bg-red-600"></div>
            <div class="text-center">
                <div class="w-16 h-16 border border-red-600 flex items-center justify-center mx-auto mb-6 bg-red-600/5">
                    <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                            d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                </div>
                <h3
                    class="font-display font-black text-2xl text-zinc-950 dark:text-white uppercase tracking-tighter mb-4">
                    Confirm Deletion</h3>
                <p class="text-zinc-500 font-mono text-[10px] uppercase tracking-widest mb-8 leading-relaxed">
                    Data destruction for "<span id="deleteProductName"
                        class="font-bold text-zinc-950 dark:text-white"></span>" is permanent. Proceed?
                </p>
                <div class="flex gap-4">
                    <button onclick="closeDeleteModal()"
                        class="flex-1 py-3 border border-zinc-200 dark:border-zinc-800 text-zinc-500 font-bold uppercase tracking-widest text-[10px] hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors">Cancel</button>
                    <button id="confirmDeleteBtn"
                        class="flex-1 py-3 bg-red-600 text-white font-bold uppercase tracking-widest text-[10px] hover:bg-red-700 transition-colors">Erase</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Category Delete Warning Modal -->
    <div id="categoryDeleteModal"
        class="fixed inset-0 z-[60] hidden items-center justify-center bg-zinc-950/90 backdrop-blur-sm">
        <div
            class="bg-white dark:bg-[#0a0a0a] border border-zinc-200 dark:border-zinc-800 p-8 max-w-sm w-full mx-4 shadow-2xl relative">
            <div class="absolute top-0 left-0 w-full h-1 bg-amber-500"></div>
            <div class="text-center">
                <div
                    class="w-16 h-16 border border-amber-500 flex items-center justify-center mx-auto mb-6 bg-amber-500/5">
                    <svg class="w-8 h-8 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                </div>
                <h3
                    class="font-display font-black text-2xl text-zinc-950 dark:text-white uppercase tracking-tighter mb-4">
                    Delete Category?</h3>
                <p class="text-zinc-500 font-mono text-[10px] uppercase tracking-widest mb-2 leading-relaxed">
                    You are about to delete the category:
                </p>
                <p class="font-bold text-zinc-950 dark:text-white font-mono text-sm uppercase tracking-widest mb-6"
                    id="deleteCategoryName"></p>
                <p class="text-zinc-400 font-mono text-[10px] uppercase tracking-widest mb-8 leading-relaxed">
                    All products in this category will be moved to <span
                        class="text-zinc-950 dark:text-white font-bold">"Uncategorized"</span>. This action is
                    permanent.
                </p>
                <div class="flex gap-4">
                    <button onclick="closeCategoryDeleteModal()"
                        class="flex-1 py-3 border border-zinc-200 dark:border-zinc-800 text-zinc-500 font-bold uppercase tracking-widest text-[10px] hover:bg-zinc-100 dark:hover:bg-zinc-900 transition-colors">Cancel</button>
                    <button id="confirmCategoryDeleteBtn"
                        class="flex-1 py-3 bg-amber-500 text-white font-bold uppercase tracking-widest text-[10px] hover:bg-amber-600 transition-colors">Delete
                        Category</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast UI System -->
    <div id="toastContainer" class="fixed bottom-6 right-6 z-[70] space-y-3 pointer-events-none"></div>

    <script src="/js/admin.js"></script>
    <script>
        var _html = document.documentElement;
        var _dMoon = document.getElementById('dashIconMoon');
        var _dSun = document.getElementById('dashIconSun');

        function _dashApplyTheme(dark) {
            _html.classList.toggle('dark', dark);
            if (_dMoon) _dMoon.classList.toggle('hidden', dark);
            if (_dSun) _dSun.classList.toggle('hidden', !dark);
        }

        var _saved = localStorage.getItem('cv-theme');
        var _sys = window.matchMedia('(prefers-color-scheme: dark)').matches;
        _dashApplyTheme(_saved === 'dark' || (!_saved && _sys));

        var _btn = document.getElementById('dashThemeToggle');
        if (_btn) {
            _btn.addEventListener('click', function () {
                var isDark = !_html.classList.contains('dark');
                localStorage.setItem('cv-theme', isDark ? 'dark' : 'light');
                _dashApplyTheme(isDark);
            });
        }

        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
            if (!localStorage.getItem('cv-theme')) _dashApplyTheme(e.matches);
        });
    </script>
</body>

</html>